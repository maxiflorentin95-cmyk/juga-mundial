<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | JUGA Mundial 2026</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
  <div class="container-fluid px-3">
    <a class="navbar-brand fw-bold fs-5" href="<%= usuario ? '/dashboard' : '/' %>">
      ⚽ <span class="text-primary">JUGA</span> <span class="text-warning">Mundial 2026</span>
    </a>
    <% if (usuario) { %>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link <%= title==='Dashboard' ? 'active' : '' %>" href="/dashboard">
            <i class="bi bi-house-fill"></i> Inicio
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= title==='Grupos' ? 'active' : '' %>" href="/grupos">
            <i class="bi bi-grid-3x3-gap-fill"></i> Grupos
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= title==='Mis Pronósticos' ? 'active' : '' %>" href="/pronosticos">
            <i class="bi bi-pencil-square"></i> Pronósticos
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= title==='Ranking' ? 'active' : '' %>" href="/ranking">
            <i class="bi bi-trophy-fill"></i> Ranking
          </a>
        </li>
        <% if (usuario.es_admin) { %>
        <li class="nav-item">
          <a class="nav-link text-warning" href="/admin">
            <i class="bi bi-shield-fill-check"></i> Admin
          </a>
        </li>
        <% } %>
      </ul>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="text-light small"><i class="bi bi-person-circle"></i> <strong><%= usuario.username %></strong></span>
        <span class="badge bg-warning text-dark px-2">
          <i class="bi bi-star-fill"></i> <%= usuario.puntos_total %> pts
        </span>
        <a href="/logout" class="btn btn-outline-danger btn-sm">
          <i class="bi bi-box-arrow-right"></i> Salir
        </a>
      </div>
    </div>
    <% } %>
  </div>
</nav>

<main class="flex-grow-1 py-4">
<div class="container-fluid px-3 px-md-4">
