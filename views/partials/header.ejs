<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta name="theme-color" content="#111827">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title><%= title %> | JUGA Mundial 2026</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1640515119681234"
     crossorigin="anonymous"></script>
</head>
<body class="d-flex flex-column min-vh-100">

<!-- ── Navbar top ─────────────────────────────────────────────── -->
<nav class="navbar navbar-dark bg-dark shadow-sm" style="min-height:52px">
  <div class="container-fluid px-3">
    <a class="navbar-brand fw-bold fs-5" href="<%= usuario ? '/dashboard' : '/' %>">
      ⚽ <span class="text-primary">JUGA</span> <span class="text-warning">Mundial 2026</span>
    </a>
    <% if (usuario) { %>
    <!-- Info visible en mobile (derecha del logo) -->
    <div class="d-flex d-lg-none align-items-center gap-2 ms-auto">
      <% if (sinPronosticar > 0) { %>
      <a href="/pronosticos" class="btn btn-warning btn-sm px-2 py-1 position-relative">
        <i class="bi bi-pencil-square"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.6rem">
          <%= sinPronosticar %>
        </span>
      </a>
      <% } %>
      <span class="badge bg-warning text-dark px-2 py-1">
        <i class="bi bi-star-fill"></i> <%= usuario.puntos_total %>
      </span>
      <a href="/perfil" class="btn btn-outline-light btn-sm px-2 py-1">
        <i class="bi bi-person-circle"></i>
      </a>
      <a href="/logout" class="btn btn-outline-danger btn-sm px-2 py-1">
        <i class="bi bi-box-arrow-right"></i>
      </a>
    </div>
    <!-- Links desktop -->
    <div class="d-none d-lg-flex align-items-center gap-3 ms-auto">
      <a class="nav-link text-light <%= title==='Dashboard' ? 'fw-bold' : '' %>" href="/dashboard">
        <i class="bi bi-house-fill"></i> Inicio
      </a>
      <a class="nav-link text-light <%= title==='Grupos' ? 'fw-bold' : '' %>" href="/grupos">
        <i class="bi bi-grid-3x3-gap-fill"></i> Grupos
      </a>
      <a class="nav-link text-light <%= title==='Partidos de Hoy' ? 'fw-bold' : '' %>" href="/hoy">
        <i class="bi bi-calendar-day-fill"></i> Hoy
      </a>
      <a class="nav-link text-light <%= title==='Historial de Partidos' ? 'fw-bold' : '' %>" href="/historial">
        <i class="bi bi-clock-history"></i> Historial
      </a>
      <a class="nav-link text-light position-relative <%= title==='Mis Pronósticos' ? 'fw-bold' : '' %>" href="/pronosticos">
        <i class="bi bi-pencil-square"></i> Pronósticos
        <% if (sinPronosticar > 0) { %>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:.6rem;margin-top:4px">
          <%= sinPronosticar %>
        </span>
        <% } %>
      </a>
      <a class="nav-link text-warning <%= title==='Pronósticos Especiales' ? 'fw-bold' : '' %>" href="/especiales">
        <i class="bi bi-stars"></i> Especiales
      </a>
      <a class="nav-link text-light <%= title==='Fase Eliminatoria' ? 'fw-bold' : '' %>" href="/eliminatoria">
        <i class="bi bi-diagram-3-fill"></i> Eliminatoria
      </a>
      <a class="nav-link text-warning <%= title==='Trivia Mundial' ? 'fw-bold' : '' %>" href="/trivia">
        <i class="bi bi-patch-question-fill"></i> Trivia
      </a>
      <a class="nav-link text-light <%= title==='Estadísticas' ? 'fw-bold' : '' %>" href="/stats">
        <i class="bi bi-bar-chart-fill"></i> Stats
      </a>
      <a class="nav-link text-light <%= title==='Ranking' ? 'fw-bold' : '' %>" href="/ranking">
        <i class="bi bi-trophy-fill"></i> Ranking
      </a>
      <% if (usuario.es_admin) { %>
      <a class="nav-link text-warning" href="/admin">
        <i class="bi bi-shield-fill-check"></i> Admin
      </a>
      <% } %>
      <a href="/perfil" class="btn btn-outline-light btn-sm ms-2">
        <i class="bi bi-person-circle me-1"></i><%= usuario.username %>
        <span class="badge bg-warning text-dark ms-1"><%= usuario.puntos_total %></span>
      </a>
      <a href="/logout" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-box-arrow-right"></i>
      </a>
    </div>
    <% } %>
  </div>
</nav>

<% if (usuario) { %>
<!-- ── Bottom nav (solo mobile/tablet) ───────────────────────── -->
<nav class="bottom-nav d-lg-none">
  <a href="/dashboard" class="<%= title==='Dashboard' ? 'active' : '' %>">
    <i class="bi bi-house-fill"></i>
    <span>Inicio</span>
  </a>
  <a href="/hoy" class="<%= title==='Partidos de Hoy' ? 'active' : '' %>">
    <i class="bi bi-calendar-day-fill"></i>
    <span>Hoy</span>
  </a>
  <a href="/pronosticos" class="<%= title==='Mis Pronósticos' ? 'active' : '' %> position-relative">
    <i class="bi bi-pencil-square"></i>
    <% if (sinPronosticar > 0) { %>
    <span class="position-absolute badge rounded-pill bg-danger" style="font-size:.55rem;top:2px;right:10px;padding:2px 4px">
      <%= sinPronosticar %>
    </span>
    <% } %>
    <span>Pronósticos</span>
  </a>
  <a href="/stats" class="<%= title==='Estadísticas' ? 'active' : '' %>">
    <i class="bi bi-bar-chart-fill"></i>
    <span>Stats</span>
  </a>
  <a href="/ranking" class="<%= title==='Ranking' ? 'active' : '' %>">
    <i class="bi bi-trophy-fill"></i>
    <span>Ranking</span>
  </a>
  <a href="/especiales" class="<%= title==='Pronósticos Especiales' ? 'active' : '' %>">
    <i class="bi bi-stars"></i>
    <span>Especiales</span>
  </a>
  <a href="/trivia" class="<%= title==='Trivia Mundial' ? 'active' : '' %>">
    <i class="bi bi-patch-question-fill"></i>
    <span>Trivia</span>
  </a>
  <% if (usuario.es_admin) { %>
  <a href="/admin" class="<%= title==='Panel Admin' ? 'active' : '' %>">
    <i class="bi bi-shield-fill-check"></i>
    <span>Admin</span>
  </a>
  <% } %>
</nav>
<% } %>

<main class="flex-grow-1 py-3">
<div class="container-fluid px-3 px-md-4">
