<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
  <a href="/hoy" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0">Historial de Partidos</h2>
</div>

<!-- Selector de partido -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" action="/historial" class="d-flex gap-2 flex-wrap align-items-end">
      <div class="flex-grow-1">
        <label class="form-label small fw-semibold text-muted mb-1">Seleccionar partido</label>
        <select name="partido" class="form-select" onchange="this.form.submit()">
          <option value="">— Elegí un partido —</option>
          <%
            const FASE_LABEL_H = {dieciseisavos:'16avos de Final',octavos:'Octavos de Final',cuartos:'Cuartos de Final',semifinal:'Semifinales',tercer_puesto:'Tercer Puesto',final:'Gran Final'};
            const grupos = [...new Set(partidos.filter(p=>p.grupo).map(p => p.grupo))].sort();
            const fases  = ['dieciseisavos','octavos','cuartos','semifinal','tercer_puesto','final'].filter(f => partidos.some(p=>p.fase===f));
          %>
          <% grupos.forEach(g => { %>
          <optgroup label="Grupo <%= g %>">
            <% partidos.filter(p => p.grupo === g).forEach(p => { %>
            <option value="<%= p.id %>" <%= selId === p.id ? 'selected' : '' %>>
              <%= new Date(p.fecha + 'T12:00:00Z').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
              · <%= p.local_nombre %> vs <%= p.visit_nombre %>
              <%= p.estado === 'finalizado' ? '✓' : p.cerrado ? '⏸' : '' %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
          <% fases.forEach(f => { %>
          <optgroup label="<%= FASE_LABEL_H[f] || f %>">
            <% partidos.filter(p => p.fase === f).forEach(p => { %>
            <option value="<%= p.id %>" <%= selId === p.id ? 'selected' : '' %>>
              <%= new Date(p.fecha + 'T12:00:00Z').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
              · <%= p.local_nombre %> vs <%= p.visit_nombre %>
              <%= p.estado === 'finalizado' ? '✓' : p.cerrado ? '⏸' : '' %>
            </option>
            <% }) %>
          </optgroup>
          <% }) %>
        </select>
      </div>
    </form>
  </div>
</div>

<% if (!detalle) { %>
<div class="alert alert-info d-flex align-items-center">
  <i class="bi bi-hand-index-fill me-2 fs-5"></i>
  <div>Seleccioná un partido arriba para ver los pronósticos.</div>
</div>

<% } else { %>

<!-- Header del partido -->
<div class="card border-0 shadow-sm mb-3">
  <div class="card-header py-2 <%= detalle.estado === 'finalizado' ? 'bg-success' : detalle.cerrado ? 'bg-secondary' : 'bg-primary' %> text-white">
    <div class="d-flex justify-content-between align-items-center">
      <span class="small">
        <% if (detalle.grupo) { %>
        <span class="badge bg-white bg-opacity-25 me-1">Grupo <%= detalle.grupo %></span>
        <% } else if (detalle.fase) { %>
        <span class="badge bg-white bg-opacity-25 me-1"><%= FASE_LABEL_H[detalle.fase] || detalle.fase %></span>
        <% } %>
        <%= new Date(detalle.fecha + 'T12:00:00Z').toLocaleDateString('es-AR',{weekday:'long',day:'numeric',month:'long'}) %>
        · <%= detalle.hora %> PY
      </span>
      <span class="badge <%= detalle.estado==='finalizado' ? 'bg-light text-success fw-bold' : detalle.cerrado ? 'bg-danger' : 'bg-light text-dark' %>">
        <%= detalle.estado==='finalizado' ? 'Finalizado' : detalle.cerrado ? 'En juego' : 'Pendiente' %>
      </span>
    </div>
  </div>
  <div class="card-body py-3">
    <div class="d-flex align-items-center justify-content-around">
      <div class="text-center">
        <div class="display-6 lh-1"><%= detalle.local_bandera %></div>
        <div class="fw-bold mt-1"><%= detalle.local_nombre %></div>
      </div>
      <div class="text-center">
        <% if (detalle.estado === 'finalizado') { %>
          <div class="display-5 fw-bold"><%= detalle.goles_local %> – <%= detalle.goles_visitante %></div>
          <div class="text-muted small">Resultado final</div>
        <% } else { %>
          <div class="fs-4 text-muted fw-bold">VS</div>
          <div class="text-muted small"><%= detalle.estadio %></div>
        <% } %>
      </div>
      <div class="text-center">
        <div class="display-6 lh-1"><%= detalle.visit_bandera %></div>
        <div class="fw-bold mt-1"><%= detalle.visit_nombre %></div>
      </div>
    </div>
  </div>
</div>

<!-- Porcentajes (visibles si hay pronósticos) -->
<% if (detalle.total_prons > 0) { %>
<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2">
    <div class="d-flex justify-content-between small text-muted mb-1">
      <span class="fw-semibold">Distribución de pronósticos</span>
      <span class="text-primary"><%= detalle.total_prons %> cargados<% if (detalle.sin_cargar > 0) { %> · <span class="text-warning"><%= detalle.sin_cargar %> sin cargar</span><% } %></span>
    </div>
    <div class="progress rounded-pill mb-1" style="height:24px">
      <% if (detalle.pct_local > 0) { %>
      <div class="progress-bar bg-primary fw-bold" style="width:<%= detalle.pct_local %>%">
        <%= detalle.pct_local > 10 ? detalle.pct_local + '%' : '' %>
      </div>
      <% } %>
      <% if (detalle.pct_empate > 0) { %>
      <div class="progress-bar bg-secondary fw-bold" style="width:<%= detalle.pct_empate %>%">
        <%= detalle.pct_empate > 10 ? detalle.pct_empate + '%' : '' %>
      </div>
      <% } %>
      <% if (detalle.pct_visita > 0) { %>
      <div class="progress-bar bg-danger fw-bold" style="width:<%= detalle.pct_visita %>%">
        <%= detalle.pct_visita > 10 ? detalle.pct_visita + '%' : '' %>
      </div>
      <% } %>
    </div>
    <div class="d-flex justify-content-between small px-1">
      <span class="text-primary fw-semibold"><%= detalle.pct_local %>% <%= detalle.local_nombre.split(' ').slice(-1)[0] %></span>
      <span class="text-secondary"><%= detalle.pct_empate %>% Empate</span>
      <span class="text-danger fw-semibold"><%= detalle.pct_visita %>% <%= detalle.visit_nombre.split(' ').slice(-1)[0] %></span>
    </div>
  </div>
</div>
<% } %>

<!-- Tabla de pronósticos (visible una vez iniciado el partido) -->
<% if (detalle.cerrado && detalle.prons.length > 0) { %>

<!-- Resumen de puntos -->
<div class="d-flex gap-2 flex-wrap mb-3">
  <span class="badge bg-warning text-dark fs-6 px-3 py-2">🎯 <%= detalle.exactos %> exactos (5pts)</span>
  <% if (!detalle.esElim) { %>
  <span class="badge bg-success fs-6 px-3 py-2">≈ <%= detalle.diferencia %> diferencia (3pts)</span>
  <% } %>
  <span class="badge bg-primary fs-6 px-3 py-2">✓ <%= detalle.ganador %> ganador (2pts)</span>
  <% if (detalle.esElim) { %>
  <span class="badge bg-info text-dark fs-6 px-3 py-2">🤜 <%= detalle.prons.filter(x=>x.base_pts===2&&x.bonus_pts===0).length + detalle.prons.filter(x=>x.base_pts===0&&x.bonus_pts===2).length %> empate (2pts)</span>
  <% } %>
  <span class="badge bg-secondary fs-6 px-3 py-2">✗ <%= detalle.fallados %> fallaron (0pts)</span>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header py-2 d-flex justify-content-between align-items-center">
    <span class="fw-bold">Pronósticos de todos</span>
    <span class="text-muted small">Resultado: <%= detalle.goles_local %>–<%= detalle.goles_visitante %></span>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-3">#</th>
          <th>Usuario</th>
          <th class="text-center">Pronóstico</th>
          <th class="text-center">Puntos</th>
        </tr>
      </thead>
      <tbody>
        <% detalle.prons.forEach((pr, i) => { %>
        <tr class="<%= pr.base_pts === 5 ? 'table-warning' : '' %>">
          <td class="ps-3 text-muted small"><%= i + 1 %></td>
          <td class="fw-semibold"><%= pr.username %></td>
          <td class="text-center">
            <span class="badge bg-dark fs-6 px-3"><%= pr.goles_local %> – <%= pr.goles_visitante %></span>
          </td>
          <td class="text-center">
            <% if (detalle.estado === 'finalizado' && pr.base_pts !== null) { %>
              <div class="d-inline-flex align-items-center gap-1 flex-wrap justify-content-center">
                <% if (pr.base_pts === 5) { %>
                  <span class="badge bg-warning text-dark px-2 py-1">🎯 5</span>
                <% } else if (pr.base_pts === 3) { %>
                  <span class="badge bg-success px-2 py-1">≈ 3</span>
                <% } else if (pr.base_pts === 2) { %>
                  <span class="badge bg-primary px-2 py-1">✓ 2</span>
                <% } else { %>
                  <span class="badge bg-secondary px-2 py-1">✗ 0</span>
                <% } %>
                <% if (pr.bonus_pts > 0) { %>
                  <span class="badge bg-info text-dark px-2 py-1">🤜 +<%= pr.bonus_pts %></span>
                <% } %>
              </div>
            <% } else { %>
              <span class="badge bg-light text-dark px-2 py-1">–</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% } else if (!detalle.cerrado) { %>
<div class="alert alert-warning d-flex align-items-center">
  <i class="bi bi-lock-fill me-2 fs-5"></i>
  <div>
    <strong>Pronósticos ocultos.</strong>
    Los pronósticos individuales se revelan una vez que el partido comience.
  </div>
</div>
<% } else if (detalle.total_prons === 0) { %>
<div class="alert alert-secondary">Sin pronósticos cargados para este partido.</div>
<% } %>

<% } %>

<%- include('partials/footer') %>
