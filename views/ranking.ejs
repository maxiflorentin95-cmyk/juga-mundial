<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0">Ranking General</h2>
</div>

<!-- AD SLOT desktop -->
<div class="ad-slot d-none d-md-flex justify-content-center mb-4">
  <div class="ad-placeholder" style="width:728px;height:90px;">
    <span class="text-muted small">Publicidad 728×90</span>
  </div>
</div>

<!-- Podio top 3 -->
<% if (ranking.length >= 3) { %>
<div class="row justify-content-center g-2 mb-4">
  <!-- 1ro — primero en mobile -->
  <div class="col-12 col-sm-4 col-md-3 order-1 order-sm-2">
    <div class="card border-warning border-2 shadow-lg text-center py-3 h-100">
      <div class="display-3 mb-1">🏆</div>
      <a href="/perfil/<%= ranking[0].username %>" class="text-decoration-none text-dark"><div class="fw-bold fs-5"><%= ranking[0].username %></div></a>
      <div class="fs-3 fw-bold text-warning"><%= ranking[0].puntos_total %> <small class="fs-6 fw-normal text-muted">pts</small></div>
      <div class="small text-muted mt-1">
        <span class="badge bg-warning text-dark me-1"><%= ranking[0].exactos %> 🎯</span>
        <span class="badge bg-success me-1"><%= ranking[0].diferencia %> ≈</span>
        <span class="badge bg-primary"><%= ranking[0].resultado %> ✓</span>
      </div>
    </div>
  </div>
  <!-- 2do -->
  <div class="col-6 col-sm-4 col-md-3 order-2 order-sm-1">
    <div class="card border-0 shadow text-center py-3 h-100">
      <div class="display-4 mb-1">🥈</div>
      <a href="/perfil/<%= ranking[1].username %>" class="text-decoration-none text-dark"><div class="fw-bold"><%= ranking[1].username %></div></a>
      <div class="fs-4 fw-bold text-secondary"><%= ranking[1].puntos_total %> <small class="fs-6 fw-normal text-muted">pts</small></div>
      <div class="small text-muted mt-1">
        <span class="badge bg-warning text-dark me-1"><%= ranking[1].exactos %> 🎯</span>
      </div>
    </div>
  </div>
  <!-- 3ro -->
  <div class="col-6 col-sm-4 col-md-3 order-3">
    <div class="card border-0 shadow text-center py-3 h-100">
      <div class="display-4 mb-1">🥉</div>
      <a href="/perfil/<%= ranking[2].username %>" class="text-decoration-none text-dark"><div class="fw-bold"><%= ranking[2].username %></div></a>
      <div class="fs-4 fw-bold" style="color:#cd7f32"><%= ranking[2].puntos_total %> <small class="fs-6 fw-normal text-muted">pts</small></div>
      <div class="small text-muted mt-1">
        <span class="badge bg-warning text-dark me-1"><%= ranking[2].exactos %> 🎯</span>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Tabla completa — desktop -->
<div class="card border-0 shadow-sm d-none d-md-block">
  <div class="card-header bg-dark text-white fw-bold py-2">
    <i class="bi bi-list-ol me-2"></i>Tabla General
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-secondary">
          <tr>
            <th class="ps-3" style="width:44px">#</th>
            <th>Jugador</th>
            <th class="text-center">Pronóst.</th>
            <th class="text-center" title="Exactos (5 pts)">🎯</th>
            <th class="text-center" title="Diferencia (3 pts)">≈</th>
            <th class="text-center" title="Resultado (2 pts)">✓</th>
            <th class="text-center" title="Bonus clasificado eliminatoria">🏅</th>
            <th class="text-center" title="Mejor racha histórica">⚡ Racha</th>
            <th class="text-center fw-bold">Pts</th>
          </tr>
        </thead>
        <tbody>
          <% ranking.forEach((u, i) => { %>
          <tr class="<%= u.id === uid ? 'table-primary' : '' %>">
            <td class="ps-3">
              <% if (i===0) { %>🥇<% } else if (i===1) { %>🥈<% } else if (i===2) { %>🥉
              <% } else { %><span class="text-muted fw-bold small"><%= i+1 %></span><% } %>
            </td>
            <td>
              <div class="d-flex align-items-center gap-2">
                <a href="/perfil/<%= u.username %>" class="text-decoration-none fw-semibold <%= u.id===uid ? 'text-primary' : 'text-dark' %>"><%= u.username %></a>
                <% if (u.id===uid) { %><span class="badge bg-primary" style="font-size:.65rem">vos</span><% } %>
                <% if (u.variacion !== null) { %>
                  <% if (u.variacion > 0) { %><span class="text-success small fw-bold"><i class="bi bi-caret-up-fill"></i>+<%= u.variacion %></span>
                  <% } else if (u.variacion < 0) { %><span class="text-danger small fw-bold"><i class="bi bi-caret-down-fill"></i><%= u.variacion %></span>
                  <% } else { %><span class="text-muted small"><i class="bi bi-dash"></i></span><% } %>
                <% } %>
              </div>
              <% if (u.especiales && (u.especiales.campeon || u.especiales.segundo || u.especiales.tercero)) { %>
              <div class="text-muted mt-1" style="font-size:.72rem; line-height:1.4">
                <% if (u.especiales.campeon) { %>🏆 <%= u.especiales.campeon %><% } %>
                <% if (u.especiales.segundo) { %> &nbsp;🥈 <%= u.especiales.segundo %><% } %>
                <% if (u.especiales.tercero) { %> &nbsp;🥉 <%= u.especiales.tercero %><% } %>
              </div>
              <% } else { %>
              <div class="text-muted mt-1" style="font-size:.68rem; opacity:.55">Sin especiales definidos</div>
              <% } %>
            </td>
            <td class="text-center text-muted small"><%= u.total_pron %></td>
            <td class="text-center"><span class="badge bg-warning text-dark"><%= u.exactos %></span></td>
            <td class="text-center"><span class="badge bg-success"><%= u.diferencia %></span></td>
            <td class="text-center"><span class="badge bg-primary"><%= u.resultado %></span></td>
            <td class="text-center">
              <% if (parseInt(u.bonus_clasificado) > 0) { %>
                <span class="badge bg-info text-dark">+<%= u.bonus_clasificado %></span>
              <% } else { %><span class="text-muted small">—</span><% } %>
            </td>
            <td class="text-center">
              <% if (u.racha_max > 0) { %>
                <span class="fw-bold" style="color:#6f42c1">⚡<%= u.racha_max %></span>
                <% if (u.racha_actual > 0 && u.racha_actual === u.racha_max) { %><span class="badge ms-1" style="background:#6f42c1;font-size:.58rem">activa</span><% } %>
              <% } else { %><span class="text-muted">—</span><% } %>
            </td>
            <td class="text-center fw-bold fs-6 text-<%= i===0?'warning':i===1?'secondary':i===2?'danger':'dark' %>"><%= u.puntos_total %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Lista mobile -->
<div class="d-md-none">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white fw-bold py-2">
      <i class="bi bi-list-ol me-2"></i>Tabla General
    </div>
    <ul class="list-group list-group-flush">
      <% ranking.forEach((u, i) => { %>
      <li class="list-group-item px-3 py-2 <%= u.id===uid ? 'list-group-item-primary' : '' %>">
        <div class="d-flex align-items-center gap-2">

          <!-- Posición -->
          <div class="text-center flex-shrink-0" style="width:28px">
            <% if (i===0) { %><span class="fs-5">🥇</span>
            <% } else if (i===1) { %><span class="fs-5">🥈</span>
            <% } else if (i===2) { %><span class="fs-5">🥉</span>
            <% } else { %><span class="fw-bold text-muted"><%= i+1 %></span><% } %>
          </div>

          <!-- Nombre + flecha + badges -->
          <div class="flex-grow-1 min-width-0">
            <div class="d-flex align-items-center gap-1 flex-wrap">
              <a href="/perfil/<%= u.username %>" class="text-decoration-none fw-bold <%= u.id===uid ? 'text-primary' : 'text-dark' %>" style="font-size:.95rem"><%= u.username %></a>
              <% if (u.id===uid) { %><span class="badge bg-primary" style="font-size:.6rem">vos</span><% } %>
              <% if (u.variacion !== null) { %>
                <% if (u.variacion > 0) { %><span class="text-success fw-bold" style="font-size:.75rem"><i class="bi bi-caret-up-fill"></i>+<%= u.variacion %></span>
                <% } else if (u.variacion < 0) { %><span class="text-danger fw-bold" style="font-size:.75rem"><i class="bi bi-caret-down-fill"></i><%= u.variacion %></span>
                <% } else { %><span class="text-muted" style="font-size:.75rem"><i class="bi bi-dash"></i></span><% } %>
              <% } %>
            </div>
            <% if (u.especiales && (u.especiales.campeon || u.especiales.segundo || u.especiales.tercero)) { %>
            <div class="text-muted mt-1" style="font-size:.7rem; line-height:1.5">
              <% if (u.especiales.campeon) { %>🏆 <%= u.especiales.campeon %><% } %>
              <% if (u.especiales.segundo) { %> 🥈 <%= u.especiales.segundo %><% } %>
              <% if (u.especiales.tercero) { %> 🥉 <%= u.especiales.tercero %><% } %>
            </div>
            <% } else { %>
            <div class="text-muted mt-1" style="font-size:.67rem; opacity:.5">Sin especiales definidos</div>
            <% } %>
            <div class="d-flex gap-2 mt-1 flex-wrap" style="font-size:.75rem">
              <span class="badge bg-warning text-dark">🎯 <%= u.exactos %></span>
              <span class="badge bg-success">≈ <%= u.diferencia %></span>
              <span class="badge bg-primary">✓ <%= u.resultado %></span>
              <% if (u.racha_max > 0) { %>
                <span class="badge" style="background:#6f42c1">⚡<%= u.racha_max %><%= u.racha_actual===u.racha_max && u.racha_actual>0 ? ' 🔥' : '' %></span>
              <% } %>
              <% if (parseInt(u.bonus_clasificado) > 0) { %>
                <span class="badge bg-info text-dark">🏅 +<%= u.bonus_clasificado %></span>
              <% } %>
            </div>
          </div>

          <!-- Puntos -->
          <div class="fw-bold fs-5 flex-shrink-0 text-<%= i===0?'warning':i===1?'secondary':i===2?'danger':'dark' %>">
            <%= u.puntos_total %><span class="text-muted fw-normal" style="font-size:.7rem"> pts</span>
          </div>

        </div>
      </li>
      <% }) %>
    </ul>
  </div>
</div>

<%- include('partials/footer') %>
