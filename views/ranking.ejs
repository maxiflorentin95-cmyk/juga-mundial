<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0">Ranking General</h2>
</div>

<!-- AD SLOT desktop -->
<div class="ad-slot d-none d-md-flex justify-content-center mb-4">
  <div class="ad-placeholder" style="width:728px;height:90px;">
    <span class="text-muted small">Publicidad 728×90</span>
  </div>
</div>

<!-- Podio top 3 -->
<% if (ranking.length >= 3) { %>
<div class="row justify-content-center g-2 mb-4">
  <!-- 1ro — primero en mobile -->
  <div class="col-12 col-sm-4 col-md-3 order-1 order-sm-2">
    <div class="card border-warning border-2 shadow-lg text-center py-3 h-100">
      <div class="display-3 mb-1">🏆</div>
      <a href="/perfil/<%= ranking[0].username %>" class="text-decoration-none text-dark"><div class="fw-bold fs-5"><%= ranking[0].username %></div></a>
      <div class="fs-3 fw-bold text-warning"><%= ranking[0].puntos_total %> <small class="fs-6 fw-normal text-muted">pts</small></div>
      <div class="small text-muted mt-1">
        <span class="badge bg-warning text-dark me-1"><%= ranking[0].exactos %> 🎯</span>
        <span class="badge bg-success me-1"><%= ranking[0].diferencia %> ≈</span>
        <span class="badge bg-primary"><%= ranking[0].resultado %> ✓</span>
      </div>
    </div>
  </div>
  <!-- 2do -->
  <div class="col-6 col-sm-4 col-md-3 order-2 order-sm-1">
    <div class="card border-0 shadow text-center py-3 h-100">
      <div class="display-4 mb-1">🥈</div>
      <a href="/perfil/<%= ranking[1].username %>" class="text-decoration-none text-dark"><div class="fw-bold"><%= ranking[1].username %></div></a>
      <div class="fs-4 fw-bold text-secondary"><%= ranking[1].puntos_total %> <small class="fs-6 fw-normal text-muted">pts</small></div>
      <div class="small text-muted mt-1">
        <span class="badge bg-warning text-dark me-1"><%= ranking[1].exactos %> 🎯</span>
      </div>
    </div>
  </div>
  <!-- 3ro -->
  <div class="col-6 col-sm-4 col-md-3 order-3">
    <div class="card border-0 shadow text-center py-3 h-100">
      <div class="display-4 mb-1">🥉</div>
      <a href="/perfil/<%= ranking[2].username %>" class="text-decoration-none text-dark"><div class="fw-bold"><%= ranking[2].username %></div></a>
      <div class="fs-4 fw-bold" style="color:#cd7f32"><%= ranking[2].puntos_total %> <small class="fs-6 fw-normal text-muted">pts</small></div>
      <div class="small text-muted mt-1">
        <span class="badge bg-warning text-dark me-1"><%= ranking[2].exactos %> 🎯</span>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Tabla completa -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-dark text-white fw-bold py-2">
    <i class="bi bi-list-ol me-2"></i>Tabla General
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle ranking-table">
        <thead class="table-secondary">
          <tr>
            <th class="ps-3" style="width:40px">#</th>
            <th>Jugador</th>
            <th class="text-center d-none d-sm-table-cell">Pronóst.</th>
            <th class="text-center">🎯</th>
            <th class="text-center d-none d-sm-table-cell">≈</th>
            <th class="text-center d-none d-md-table-cell">✓</th>
            <th class="text-center fw-bold">Pts</th>
          </tr>
        </thead>
        <tbody>
          <% ranking.forEach((u, i) => { %>
          <tr class="<%= u.id === uid ? 'table-primary' : '' %>">
            <td class="ps-3">
              <% if (i === 0) { %><span class="fs-5">🥇</span>
              <% } else if (i === 1) { %><span class="fs-5">🥈</span>
              <% } else if (i === 2) { %><span class="fs-5">🥉</span>
              <% } else { %><span class="text-muted fw-bold small"><%= i+1 %></span>
              <% } %>
            </td>
            <td>
              <a href="/perfil/<%= u.username %>" class="text-decoration-none">
                <span class="fw-<%= u.id === uid ? 'bold text-primary' : 'semibold' %> ranking-nombre">
                  <%= u.username %>
                </span>
              </a>
              <% if (u.id === uid) { %>
                <span class="badge bg-primary ms-1 d-none d-sm-inline">vos</span>
              <% } %>
            </td>
            <td class="text-center text-muted small d-none d-sm-table-cell"><%= u.total_pron %></td>
            <td class="text-center">
              <span class="badge bg-warning text-dark"><%= u.exactos %></span>
            </td>
            <td class="text-center d-none d-sm-table-cell">
              <span class="badge bg-success"><%= u.diferencia %></span>
            </td>
            <td class="text-center d-none d-md-table-cell">
              <span class="badge bg-primary"><%= u.resultado %></span>
            </td>
            <td class="text-center fw-bold fs-6 text-<%= i===0 ? 'warning' : i===1 ? 'secondary' : i===2 ? 'danger' : 'dark' %>">
              <%= u.puntos_total %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
