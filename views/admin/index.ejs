<%- include('../partials/header') %>

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0"><i class="bi bi-shield-fill-check text-warning me-2"></i>Panel de Administración</h2>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-primary"><%= stats.totalPartidos %></div>
      <div class="small text-muted">Partidos</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-success"><%= stats.finalizados %></div>
      <div class="small text-muted">Finalizados</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-warning"><%= stats.pendientes %></div>
      <div class="small text-muted">Pendientes</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-info"><%= stats.usuarios %></div>
      <div class="small text-muted">Usuarios</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-secondary"><%= stats.pronosticos %></div>
      <div class="small text-muted">Pronósticos</div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Cargar resultados por grupo -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-danger text-white fw-bold">
        <i class="bi bi-pencil-fill me-2"></i>Cargar Resultados
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Seleccioná el grupo para cargar o modificar resultados:</p>
        <div class="d-flex flex-wrap gap-2">
          <% grupos.forEach(g => { %>
          <a href="/admin/resultados/<%= g %>" class="btn btn-outline-danger">
            Grupo <%= g %>
          </a>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Gestión de usuarios -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-people-fill me-2"></i>Gestión de Usuarios
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Administrá los roles de los usuarios de la plataforma.</p>
        <a href="/admin/usuarios" class="btn btn-dark">
          <i class="bi bi-person-gear me-2"></i>Ver usuarios
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
