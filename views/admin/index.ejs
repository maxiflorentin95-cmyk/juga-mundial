<%- include('../partials/header') %>

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0"><i class="bi bi-shield-fill-check text-warning me-2"></i>Panel de Administración</h2>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-primary"><%= stats.totalPartidos %></div>
      <div class="small text-muted">Partidos</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-success"><%= stats.finalizados %></div>
      <div class="small text-muted">Finalizados</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-warning"><%= stats.pendientes %></div>
      <div class="small text-muted">Pendientes</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-info"><%= stats.usuarios %></div>
      <div class="small text-muted">Usuarios</div>
    </div>
  </div>
  <div class="col-6 col-md-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center py-3">
      <div class="fw-bold fs-3 text-secondary"><%= stats.pronosticos %></div>
      <div class="small text-muted">Pronósticos</div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Cargar resultados por grupo -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-danger text-white fw-bold">
        <i class="bi bi-pencil-fill me-2"></i>Cargar Resultados
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Seleccioná el grupo para cargar o modificar resultados:</p>
        <div class="d-flex flex-wrap gap-2">
          <% grupos.forEach(g => { %>
          <a href="/admin/resultados/<%= g %>" class="btn btn-outline-danger">
            Grupo <%= g %>
          </a>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recalcular puntos -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-primary text-white fw-bold">
        <i class="bi bi-arrow-repeat me-2"></i>Recalcular Ranking
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Recalcula <code>puntos_total</code> de todos los usuarios desde los pronósticos guardados.
          Usá esto si el ranking no coincide con los resultados cargados.
        </p>
        <button id="btnRecalcular" class="btn btn-primary">
          <i class="bi bi-calculator me-2"></i>Recalcular ahora
        </button>
        <div id="recalcularMsg" class="mt-3 small"></div>
      </div>
    </div>
  </div>

  <!-- Recalcular puntos eliminatoria -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-danger text-white fw-bold">
        <i class="bi bi-arrow-repeat me-2"></i>Recalcular Eliminatoria
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Recalcula los puntos de <strong>todos los partidos de eliminatoria</strong> finalizados con las reglas correctas
          (5/3/2/0 base + <strong>+1 bonus</strong> si predijo empate y acertó clasificado). Luego actualiza el ranking.
          Usá esto si los puntos de 16avos/octavos/etc. están mal.
        </p>
        <button id="btnRecalcularElim" class="btn btn-danger">
          <i class="bi bi-calculator me-2"></i>Recalcular eliminatoria
        </button>
        <div id="recalcularElimMsg" class="mt-3 small"></div>
      </div>
    </div>
  </div>

  <!-- Recalcular partido específico -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-secondary text-white fw-bold">
        <i class="bi bi-arrow-clockwise me-2"></i>Recalcular Partido Específico
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Recalcula los puntos de <strong>un partido en particular</strong> (por ID).
          Útil si alguien cargó el pronóstico después de que el partido fue finalizado.
        </p>
        <div class="d-flex gap-2">
          <input type="number" id="inputPartidoId" class="form-control form-control-sm" placeholder="ID del partido" style="max-width:160px">
          <button id="btnRecalcularPartido" class="btn btn-secondary btn-sm">
            <i class="bi bi-calculator me-1"></i>Recalcular
          </button>
        </div>
        <div id="recalcularPartidoMsg" class="mt-3 small"></div>
      </div>
    </div>
  </div>

  <!-- Corrección de horarios -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-clock-history me-2"></i>Corregir Horarios (Paraguay)
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Actualiza los 72 partidos a hora Paraguay (UTC-3 fijo).<br>
          Usá esto si los horarios se ven mal. Solo necesita ejecutarse una vez.
        </p>
        <button id="btnHorarios" class="btn btn-warning">
          <i class="bi bi-clock me-2"></i>Corregir horarios ahora
        </button>
        <div id="horariosMsg" class="mt-3 small"></div>
      </div>
    </div>
  </div>

  <!-- Sincronización API-Football -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-success text-white fw-bold">
        <i class="bi bi-arrow-repeat me-2"></i>Sincronizar con API-Football
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Importa resultados finalizados y actualiza horarios desde la API oficial.
          Requiere <code>API_FOOTBALL_KEY</code> configurada en Render.
        </p>
        <button id="btnSync" class="btn btn-success">
          <i class="bi bi-cloud-download me-2"></i>Sincronizar ahora
        </button>
        <div id="syncMsg" class="mt-3 small"></div>
      </div>
    </div>
  </div>

  <!-- Gestión de usuarios -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-people-fill me-2"></i>Gestión de Usuarios
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Administrá los roles de los usuarios de la plataforma.</p>
        <a href="/admin/usuarios" class="btn btn-dark">
          <i class="bi bi-person-gear me-2"></i>Ver usuarios
        </a>
      </div>
    </div>
  </div>

  <!-- Resultados especiales -->
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-stars me-2"></i>Cargar resultados especiales (Podio / Goleador / MVP)
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Cargá el resultado real de cada categoría. Al guardar se asignan los puntos automáticamente.<br>
          <strong>Puntos:</strong> Campeón 10 · 2do 8 · 3er 5 · Goleador 10 · MVP 10
        </p>
        <div class="row g-2">
          <% [
            { tipo:'campeon',  label:'🥇 Campeón',        placeholder:'Ej: Argentina',   esEquipo:true },
            { tipo:'segundo',  label:'🥈 2do puesto',      placeholder:'Ej: Francia',     esEquipo:true },
            { tipo:'tercero',  label:'🥉 3er puesto',      placeholder:'Ej: Marruecos',   esEquipo:true },
            { tipo:'goleador', label:'⚽ Goleador',        placeholder:'Ej: Kylian Mbappé', esEquipo:false },
            { tipo:'mvp',      label:'🌟 MVP del torneo',  placeholder:'Ej: Vinicius Jr.', esEquipo:false },
          ].forEach(e => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <label class="form-label small fw-semibold mb-1"><%= e.label %></label>
            <div class="input-group input-group-sm">
              <input type="text" class="form-control inp-res-especial"
                id="res-<%= e.tipo %>" data-tipo="<%= e.tipo %>"
                placeholder="<%= e.placeholder %>" autocomplete="off">
              <button class="btn btn-warning btn-guardar-res-especial" data-tipo="<%= e.tipo %>">
                <i class="bi bi-check2-circle"></i>
              </button>
            </div>
            <div class="msg-res-especial small mt-1" id="msg-res-<%= e.tipo %>"></div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Fase Eliminatoria -->
  <div class="col-12">
    <div class="card border-0 shadow-sm border-warning">
      <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-diagram-3-fill me-2"></i>Fase Eliminatoria
      </div>
      <div class="card-body">
        <div class="row g-3">
          <!-- Agregar cruce -->
          <div class="col-12 col-lg-7">
            <p class="text-muted small mb-2">Agregá los cruces a medida que se definan. Elegí los equipos, la fase, fecha y hora (hora Paraguay).</p>
            <div class="row g-2" id="form-elim">
              <div class="col-12 col-sm-5">
                <label class="form-label small fw-semibold mb-1">Local</label>
                <select id="elim-local" class="form-select form-select-sm">
                  <option value="">— Cargar equipos —</option>
                </select>
              </div>
              <div class="col-12 col-sm-5">
                <label class="form-label small fw-semibold mb-1">Visitante</label>
                <select id="elim-visit" class="form-select form-select-sm">
                  <option value="">— Cargar equipos —</option>
                </select>
              </div>
              <div class="col-12 col-sm-2 d-flex align-items-end">
                <button id="btnCargarEquipos" class="btn btn-outline-warning btn-sm w-100">
                  <i class="bi bi-arrow-repeat"></i> Cargar
                </button>
              </div>
              <div class="col-12 col-sm-4">
                <label class="form-label small fw-semibold mb-1">Fase</label>
                <select id="elim-fase" class="form-select form-select-sm">
                  <option value="dieciseisavos">16avos de Final</option>
                  <option value="octavos">Octavos de Final</option>
                  <option value="cuartos">Cuartos de Final</option>
                  <option value="semifinal">Semifinales</option>
                  <option value="tercer_puesto">Tercer Puesto</option>
                  <option value="final">Gran Final</option>
                </select>
              </div>
              <div class="col-6 col-sm-4">
                <label class="form-label small fw-semibold mb-1">Fecha</label>
                <input type="date" id="elim-fecha" class="form-control form-control-sm">
              </div>
              <div class="col-6 col-sm-4">
                <label class="form-label small fw-semibold mb-1">Hora (PY)</label>
                <input type="time" id="elim-hora" class="form-control form-control-sm">
              </div>
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold mb-1">Estadio <span class="text-muted">(opcional)</span></label>
                <input type="text" id="elim-estadio" class="form-control form-control-sm" placeholder="Ej: MetLife Stadium">
              </div>
              <div class="col-12 col-sm-6">
                <label class="form-label small fw-semibold mb-1">Ciudad <span class="text-muted">(opcional)</span></label>
                <input type="text" id="elim-ciudad" class="form-control form-control-sm" placeholder="Ej: East Rutherford">
              </div>
              <div class="col-12">
                <button id="btnAgregarCruce" class="btn btn-warning">
                  <i class="bi bi-plus-circle me-1"></i>Agregar cruce
                </button>
                <span id="msg-elim" class="small ms-2"></span>
              </div>
            </div>
          </div>
          <!-- Ir a resultados -->
          <div class="col-12 col-lg-5 d-flex flex-column justify-content-center gap-2">
            <a href="/admin/resultados-eliminatoria" class="btn btn-warning">
              <i class="bi bi-pencil-fill me-2"></i>Cargar resultados de eliminatoria
            </a>
            <a href="/eliminatoria" class="btn btn-outline-warning" target="_blank">
              <i class="bi bi-eye me-2"></i>Ver como usuario
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Normalizar especiales -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-info text-dark fw-bold">
        <i class="bi bi-pencil-square me-2"></i>Unificar valor de pronóstico especial
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Corregí variantes de escritura (ej: todas las formas de "Mbappé" → "Kylian Mbappé"). Usa búsqueda parcial sin distinguir mayúsculas.</p>
        <div class="row g-2">
          <div class="col-12 col-sm-4">
            <select class="form-select form-select-sm" id="norm-tipo">
              <option value="goleador">⚽ Goleador</option>
              <option value="mvp">🌟 MVP</option>
              <option value="campeon">🥇 Campeón</option>
              <option value="segundo">🥈 2do puesto</option>
              <option value="tercero">🥉 3er puesto</option>
            </select>
          </div>
          <div class="col-12 col-sm-4">
            <input type="text" id="norm-patron" class="form-control form-control-sm" placeholder="Patrón (ej: mbappe)">
          </div>
          <div class="col-12 col-sm-4">
            <input type="text" id="norm-nuevo" class="form-control form-control-sm" placeholder="Valor correcto (ej: Kylian Mbappé)">
          </div>
          <div class="col-12">
            <button class="btn btn-info btn-sm" id="btn-normalizar">
              <i class="bi bi-arrow-repeat me-1"></i>Unificar
            </button>
            <span id="msg-normalizar" class="small ms-2"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Limpiar partido -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm border-danger">
      <div class="card-header bg-danger text-white fw-bold">
        <i class="bi bi-trash-fill me-2"></i>Limpiar pronósticos de un partido
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Borra todos los pronósticos de un partido y revierte los puntos. Útil si nadie pudo completar a tiempo.</p>
        <div class="d-flex gap-2 flex-wrap mb-2">
          <select id="selPartidoLimpiar" class="form-select" style="max-width:320px">
            <option value="">— Seleccioná un partido —</option>
            <% grupos.forEach(g => { %>
            <optgroup label="Grupo <%= g %>">
            <% /* partidos cargados via stats, usamos un endpoint separado */ %>
            </optgroup>
            <% }) %>
          </select>
          <button id="btnLimpiarPartido" class="btn btn-danger" disabled>
            <i class="bi bi-trash me-1"></i>Limpiar
          </button>
        </div>
        <div id="limpiarMsg" class="small mt-2"></div>
        <div class="mt-2">
          <a href="#" id="btnCargarPartidos" class="small text-primary">Cargar lista de partidos</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Cargar pronóstico manual -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm border-info">
      <div class="card-header bg-info text-dark fw-bold">
        <i class="bi bi-pencil-square me-2"></i>Cargar pronóstico manual
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Cargá o modificá el pronóstico de un usuario para un partido específico.</p>
        <div class="row g-2 mb-2">
          <div class="col-12 col-sm-5">
            <input type="text" id="inpPronUsername" class="form-control" placeholder="Usuario" value="Ferfre">
          </div>
          <div class="col-12">
            <select id="selPronPartido" class="form-select">
              <option value="">— Primero cargá la lista de partidos arriba —</option>
            </select>
          </div>
          <div class="col-5">
            <input type="number" id="inpPronLocal" class="form-control text-center fw-bold" placeholder="Local" min="0" max="20" value="2">
          </div>
          <div class="col-2 d-flex align-items-center justify-content-center fw-bold text-muted">–</div>
          <div class="col-5">
            <input type="number" id="inpPronVisit" class="form-control text-center fw-bold" placeholder="Visita" min="0" max="20" value="1">
          </div>
          <div class="col-12" id="divClasifPron" style="display:none">
            <label class="form-label small fw-semibold mb-1 text-info">Clasificado (solo eliminatoria)</label>
            <select id="selClasifPron" class="form-select">
              <option value="">— Sin clasificado —</option>
            </select>
          </div>
        </div>
        <button id="btnCargarPron" class="btn btn-info w-100">
          <i class="bi bi-save me-1"></i>Cargar pronóstico
        </button>
        <div id="pronManualMsg" class="small mt-2"></div>
      </div>
    </div>
  </div>

  <!-- Renombrar usuario -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-secondary text-white fw-bold">
        <i class="bi bi-pencil-fill me-2"></i>Renombrar usuario
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">Cambia el nombre de usuario sin perder datos.</p>
        <div class="row g-2 mb-2">
          <div class="col">
            <input type="text" id="inpUsernameActual" class="form-control" placeholder="Nombre actual" value="mfiorentin">
          </div>
          <div class="col-auto d-flex align-items-center text-muted"><i class="bi bi-arrow-right"></i></div>
          <div class="col">
            <input type="text" id="inpUsernameNuevo" class="form-control" placeholder="Nombre nuevo" value="Maxifl">
          </div>
        </div>
        <button id="btnRenombrar" class="btn btn-secondary">
          <i class="bi bi-check2 me-1"></i>Renombrar
        </button>
        <div id="renombrarMsg" class="small mt-2"></div>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('btnRecalcular').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Calculando...';
  const msg = document.getElementById('recalcularMsg');
  try {
    const r = await fetch('/admin/recalcular-puntos', { method: 'POST' }).then(x => x.json());
    if (r.ok) {
      const top = r.ranking.slice(0,5).map((u,i) => `${i+1}. ${u.username} – ${u.puntos_total} pts`).join('<br>');
      msg.innerHTML = `<div class="alert alert-success py-2">${r.msg}<hr class="my-1">${top}</div>`;
    } else {
      msg.innerHTML = `<div class="alert alert-danger py-2">${r.msg}</div>`;
    }
  } catch(e) {
    msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`;
  }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-calculator me-2"></i>Recalcular ahora';
});

document.getElementById('btnRecalcularElim').addEventListener('click', async function() {
  if (!confirm('¿Recalcular puntos de TODOS los partidos de eliminatoria finalizados? Esto sobrescribirá los puntos actuales.')) return;
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Recalculando...';
  const msg = document.getElementById('recalcularElimMsg');
  try {
    const r = await fetch('/admin/recalcular-eliminatoria', { method: 'POST' }).then(x => x.json());
    msg.innerHTML = r.ok
      ? `<div class="alert alert-success py-2">${r.msg}</div>`
      : `<div class="alert alert-danger py-2">${r.msg}</div>`;
  } catch(e) {
    msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`;
  }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-calculator me-2"></i>Recalcular eliminatoria';
});

document.getElementById('btnRecalcularPartido').addEventListener('click', async function() {
  const id = document.getElementById('inputPartidoId').value.trim();
  if (!id) return;
  if (!confirm(`¿Recalcular puntos del partido #${id}? Esto sobrescribirá los puntos de todos sus pronósticos.`)) return;
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>...';
  const msg = document.getElementById('recalcularPartidoMsg');
  try {
    const r = await fetch('/admin/recalcular-partido', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ partido_id: parseInt(id) })
    }).then(x => x.json());
    msg.innerHTML = r.ok
      ? `<div class="alert alert-success py-2">${r.msg}</div>`
      : `<div class="alert alert-danger py-2">${r.msg}</div>`;
  } catch(e) {
    msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`;
  }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-calculator me-1"></i>Recalcular';
});

document.getElementById('btnHorarios').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Corrigiendo...';
  const msg = document.getElementById('horariosMsg');
  try {
    const r = await fetch('/admin/corregir-horarios', { method: 'POST' }).then(x => x.json());
    if (r.ok) {
      msg.innerHTML = `<div class="alert alert-success py-2">✓ ${r.actualizados} partidos corregidos${r.noEncontrados.length ? '<br>No encontrados: ' + r.noEncontrados.join(', ') : ''}</div>`;
    } else {
      msg.innerHTML = `<div class="alert alert-danger py-2">${r.msg}</div>`;
    }
  } catch(e) {
    msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`;
  }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-clock me-2"></i>Corregir horarios ahora';
});

document.getElementById('btnSync').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sincronizando...';
  const msg = document.getElementById('syncMsg');
  msg.innerHTML = '';
  try {
    const r = await fetch('/admin/sync', { method: 'POST' }).then(x => x.json());
    if (r.ok) {
      const lineas = [];
      if (r.insertados) lineas.push(`✚ ${r.insertados} cruce(s) de eliminatoria insertado(s)`);
      if (r.actualizados) lineas.push(`✓ ${r.actualizados} resultado(s) actualizado(s)`);
      if (!lineas.length) lineas.push('Sin novedades');
      if (r.errores && r.errores.length) lineas.push('Errores: ' + r.errores.join(', '));
      msg.innerHTML = `<div class="alert alert-success py-2">${lineas.join('<br>')}</div>`;
    } else if (r.msg && r.msg.includes('Free plans')) {
      msg.innerHTML = `<div class="alert alert-warning py-2">
        <strong>Plan gratuito de API-Football no incluye 2026.</strong><br>
        Opciones: <a href="https://dashboard.api-football.com" target="_blank">actualizar plan</a>
        o cargar resultados manualmente desde el panel de arriba.
      </div>`;
    } else {
      msg.innerHTML = `<div class="alert alert-danger py-2">${r.msg}</div>`;
    }
  } catch(e) {
    msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`;
  }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-cloud-download me-2"></i>Sincronizar ahora';
});

// Cargar lista de partidos para ambos selectores
let partidosCache = null;
async function cargarListaPartidos() {
  if (partidosCache) return partidosCache;
  const partidos = await fetch('/admin/partidos-lista').then(r => r.json());
  partidosCache = partidos;
  return partidos;
}

document.getElementById('btnCargarPartidos').addEventListener('click', async function(e) {
  e.preventDefault();
  this.textContent = 'Cargando...';
  try {
    const partidos = await cargarListaPartidos();
    // Selector de limpiar
    const sel = document.getElementById('selPartidoLimpiar');
    sel.innerHTML = '<option value="">— Seleccioná un partido —</option>';
    // Selector de pronóstico manual
    const selP = document.getElementById('selPronPartido');
    selP.innerHTML = '<option value="">— Seleccioná un partido —</option>';
    partidos.forEach(p => {
      const txt = `${p.fecha} · ${p.local} vs ${p.visit} (${p.total} prons)`;
      [sel, selP].forEach(s => {
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = txt;
        // Pre-seleccionar Chequia vs Sudáfrica en el selector de pronóstico manual
        if (p.local.includes('Chequia') && p.visit.includes('Sudáfrica')) opt.selected = true;
        s.appendChild(opt);
      });
    });
    document.getElementById('btnLimpiarPartido').disabled = false;
    this.style.display = 'none';
  } catch(e) { this.textContent = 'Error al cargar'; }
});

document.getElementById('btnLimpiarPartido').addEventListener('click', async function() {
  const id = document.getElementById('selPartidoLimpiar').value;
  if (!id) return;
  const txt = document.getElementById('selPartidoLimpiar').selectedOptions[0].text;
  if (!confirm(`¿Borrar TODOS los pronósticos de:\n${txt}?\n\nEsta acción no se puede deshacer.`)) return;
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Limpiando...';
  const msg = document.getElementById('limpiarMsg');
  try {
    const r = await fetch('/admin/limpiar-partido', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ partido_id: id })
    }).then(x => x.json());
    msg.innerHTML = r.ok
      ? `<div class="alert alert-success py-2">${r.msg}</div>`
      : `<div class="alert alert-danger py-2">${r.msg}</div>`;
  } catch(e) { msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`; }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-trash me-1"></i>Limpiar';
});

// Mostrar/ocultar clasificado según si el partido seleccionado es eliminatoria
document.getElementById('selPronPartido').addEventListener('change', function() {
  const pid = parseInt(this.value);
  const partido = (partidosCache || []).find(p => p.id === pid);
  const div = document.getElementById('divClasifPron');
  const sel = document.getElementById('selClasifPron');
  if (partido && partido.fase && partido.fase !== 'grupos') {
    sel.innerHTML = `<option value="">— Sin clasificado —</option>
      <option value="${partido.local_id}">${partido.local_bandera || ''} ${partido.local}</option>
      <option value="${partido.visit_id}">${partido.visit_bandera || ''} ${partido.visit}</option>`;
    div.style.display = '';
  } else {
    div.style.display = 'none';
    sel.value = '';
  }
});

document.getElementById('btnCargarPron').addEventListener('click', async function() {
  const username     = document.getElementById('inpPronUsername').value.trim();
  const partido_id   = document.getElementById('selPronPartido').value;
  const gl           = document.getElementById('inpPronLocal').value;
  const gv           = document.getElementById('inpPronVisit').value;
  const clasificado_id = document.getElementById('selClasifPron').value || null;
  const msg          = document.getElementById('pronManualMsg');
  if (!username || !partido_id || gl==='' || gv==='') {
    msg.innerHTML = '<div class="alert alert-warning py-2">Completá todos los campos</div>';
    return;
  }
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
  try {
    const r = await fetch('/admin/cargar-pronostico-manual', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ username, partido_id, goles_local: gl, goles_visitante: gv, clasificado_id })
    }).then(x => x.json());
    msg.innerHTML = r.ok
      ? `<div class="alert alert-success py-2">${r.msg}</div>`
      : `<div class="alert alert-danger py-2">${r.msg}</div>`;
  } catch(e) { msg.innerHTML = '<div class="alert alert-danger py-2">Error de red</div>'; }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-save me-1"></i>Cargar pronóstico';
});

document.getElementById('btnRenombrar').addEventListener('click', async function() {
  const actual = document.getElementById('inpUsernameActual').value.trim();
  const nuevo  = document.getElementById('inpUsernameNuevo').value.trim();
  if (!actual || !nuevo) return;
  if (!confirm(`¿Renombrar "${actual}" → "${nuevo}"?`)) return;
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
  const msg = document.getElementById('renombrarMsg');
  try {
    const r = await fetch('/admin/renombrar-usuario', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ username_actual: actual, username_nuevo: nuevo })
    }).then(x => x.json());
    msg.innerHTML = r.ok
      ? `<div class="alert alert-success py-2">${r.msg}</div>`
      : `<div class="alert alert-danger py-2">${r.msg}</div>`;
    if (r.ok) { document.getElementById('inpUsernameActual').value = nuevo; }
  } catch(e) { msg.innerHTML = `<div class="alert alert-danger py-2">Error de red</div>`; }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-check2 me-1"></i>Renombrar';
});
// Normalizar especiales
document.getElementById('btn-normalizar').addEventListener('click', async function() {
  const tipo      = document.getElementById('norm-tipo').value;
  const patron    = document.getElementById('norm-patron').value.trim();
  const valor_nuevo = document.getElementById('norm-nuevo').value.trim();
  const msg       = document.getElementById('msg-normalizar');
  if (!patron || !valor_nuevo) { msg.innerHTML = '<span class="text-danger">Completá patrón y valor nuevo</span>'; return; }
  this.disabled = true;
  try {
    const r = await fetch('/especiales/normalizar', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ tipo, patron, valor_nuevo })
    }).then(x => x.json());
    msg.innerHTML = `<span class="${r.ok ? 'text-success' : 'text-danger'}">${r.msg}</span>`;
  } catch(e) { msg.innerHTML = '<span class="text-danger">Error de red</span>'; }
  this.disabled = false;
});

// Fase eliminatoria – cargar equipos
let equiposCache = null;
document.getElementById('btnCargarEquipos').addEventListener('click', async function() {
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
  try {
    if (!equiposCache) {
      equiposCache = await fetch('/admin/equipos-lista').then(r => r.json());
    }
    ['elim-local', 'elim-visit'].forEach(selId => {
      const sel = document.getElementById(selId);
      sel.innerHTML = '<option value="">— Seleccioná —</option>';
      let grupoActual = '';
      equiposCache.forEach(e => {
        if (e.grupo !== grupoActual) {
          grupoActual = e.grupo;
          const og = document.createElement('optgroup');
          og.label = 'Grupo ' + e.grupo;
          sel.appendChild(og);
        }
        const opt = document.createElement('option');
        opt.value = e.id;
        opt.textContent = e.bandera + ' ' + e.nombre;
        sel.lastChild.appendChild(opt);
      });
    });
  } catch(e) { document.getElementById('msg-elim').textContent = 'Error al cargar equipos'; }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-arrow-repeat"></i> Recargar';
});

document.getElementById('btnAgregarCruce').addEventListener('click', async function() {
  const local_id = document.getElementById('elim-local').value;
  const visit_id = document.getElementById('elim-visit').value;
  const fase     = document.getElementById('elim-fase').value;
  const fecha    = document.getElementById('elim-fecha').value;
  const hora     = document.getElementById('elim-hora').value;
  const estadio  = document.getElementById('elim-estadio').value.trim();
  const ciudad   = document.getElementById('elim-ciudad').value.trim();
  const msg      = document.getElementById('msg-elim');

  if (!local_id || !visit_id || !fecha || !hora) {
    msg.innerHTML = '<span class="text-danger">Completá local, visitante, fecha y hora</span>';
    return;
  }
  if (local_id === visit_id) {
    msg.innerHTML = '<span class="text-danger">Local y visitante deben ser distintos</span>';
    return;
  }
  this.disabled = true;
  this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Agregando...';
  try {
    const r = await fetch('/admin/agregar-partido-eliminatoria', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ local_id, visit_id, fase, fecha, hora, estadio, ciudad })
    }).then(x => x.json());
    msg.innerHTML = `<span class="${r.ok ? 'text-success' : 'text-danger'}">${r.msg}</span>`;
    if (r.ok) {
      // limpiar selects de equipos para el próximo cruce
      document.getElementById('elim-local').value = '';
      document.getElementById('elim-visit').value = '';
    }
  } catch(e) { msg.innerHTML = '<span class="text-danger">Error de red</span>'; }
  this.disabled = false;
  this.innerHTML = '<i class="bi bi-plus-circle me-1"></i>Agregar cruce';
});

// Resultados especiales
document.querySelectorAll('.btn-guardar-res-especial').forEach(btn => {
  btn.addEventListener('click', async function() {
    const tipo  = this.dataset.tipo;
    const valor = document.getElementById('res-' + tipo).value.trim();
    const msg   = document.getElementById('msg-res-' + tipo);
    if (!valor) { msg.innerHTML = '<span class="text-danger">Ingresá el valor</span>'; return; }
    this.disabled = true;
    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    try {
      const r = await fetch('/especiales/resultado', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ tipo, valor })
      }).then(x => x.json());
      msg.innerHTML = `<span class="${r.ok ? 'text-success' : 'text-danger'}">${r.msg}</span>`;
      setTimeout(() => { msg.innerHTML = ''; }, 6000);
    } catch(e) { msg.innerHTML = '<span class="text-danger">Error de red</span>'; }
    this.disabled = false;
    this.innerHTML = '<i class="bi bi-check2-circle"></i>';
  });
});
</script>

