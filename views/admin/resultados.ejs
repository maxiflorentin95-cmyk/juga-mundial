<%- include('../partials/header') %>

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
  <a href="/admin" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0">Grupo <%= grupo %> – Cargar Resultados</h2>
</div>

<div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index:9999"></div>

<div class="row g-3">
  <% partidos.forEach(p => { %>
  <div class="col-12 col-md-6 col-xl-4">
    <div class="card border-0 shadow-sm h-100" id="card-<%= p.id %>">
      <div class="card-header py-2 <%= p.estado === 'finalizado' ? 'bg-success text-white' : 'bg-secondary text-white' %>">
        <div class="d-flex justify-content-between align-items-center">
          <small>
            <i class="bi bi-calendar3 me-1"></i>
            <%= new Date(p.fecha + 'T12:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
            · <%= p.hora %>
          </small>
          <span class="badge bg-white text-dark">
            <%= p.estado === 'finalizado' ? '✓ Cargado' : 'Pendiente' %>
          </span>
        </div>
      </div>
      <div class="card-body">
        <!-- Equipos -->
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div class="text-center flex-grow-1">
            <div class="fs-3"><%= p.local_bandera %></div>
            <div class="fw-bold small"><%= p.local_nombre %></div>
          </div>
          <div class="text-center px-2 text-muted fw-bold">VS</div>
          <div class="text-center flex-grow-1">
            <div class="fs-3"><%= p.visit_bandera %></div>
            <div class="fw-bold small"><%= p.visit_nombre %></div>
          </div>
        </div>

        <!-- Form resultado -->
        <div class="resultado-form" data-id="<%= p.id %>">
          <label class="form-label small fw-bold d-block text-center mb-2">Resultado</label>
          <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <input type="number" class="form-control form-control-sm text-center fw-bold res-local"
              min="0" max="30" style="width:65px"
              value="<%= p.goles_local !== null ? p.goles_local : '' %>"
              placeholder="0">
            <span class="fw-bold">–</span>
            <input type="number" class="form-control form-control-sm text-center fw-bold res-visit"
              min="0" max="30" style="width:65px"
              value="<%= p.goles_visitante !== null ? p.goles_visitante : '' %>"
              placeholder="0">
          </div>
          <button class="btn btn-danger btn-sm w-100 btn-resultado" data-id="<%= p.id %>">
            <i class="bi bi-save me-1"></i>
            <%= p.estado === 'finalizado' ? 'Modificar resultado' : 'Guardar resultado' %>
          </button>
          <% if (p.estado === 'finalizado') { %>
          <button class="btn btn-outline-secondary btn-sm w-100 mt-1 btn-resetear" data-id="<%= p.id %>">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Resetear
          </button>
          <% } %>
        </div>
      </div>
      <div class="card-footer bg-transparent text-muted small py-1">
        <i class="bi bi-geo-alt"></i> <%= p.estadio %>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<script>
function showToast(msg, ok) {
  const id = 'toast' + Date.now();
  const html = `
    <div id="${id}" class="toast align-items-center text-white border-0 ${ok ? 'bg-success' : 'bg-danger'}" role="alert">
      <div class="d-flex">
        <div class="toast-body fw-semibold">${msg}</div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>`;
  document.getElementById('toast-container').insertAdjacentHTML('beforeend', html);
  const toastEl = document.getElementById(id);
  new bootstrap.Toast(toastEl, { delay: 3000 }).show();
  toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
}

document.querySelectorAll('.btn-resultado').forEach(btn => {
  btn.addEventListener('click', async function () {
    const id = this.dataset.id;
    const card = document.getElementById('card-' + id);
    const gl = card.querySelector('.res-local').value;
    const gv = card.querySelector('.res-visit').value;
    if (gl === '' || gv === '') { showToast('Ingresá ambos goles', false); return; }

    this.disabled = true;
    try {
      const res = await fetch('/admin/resultado', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ partido_id: id, goles_local: gl, goles_visitante: gv })
      });
      const data = await res.json();
      showToast(data.msg, data.ok);
      if (data.ok) {
        card.querySelector('.card-header').className = 'card-header py-2 bg-success text-white';
        card.querySelector('.card-header .badge').textContent = '✓ Cargado';
        this.innerHTML = '<i class="bi bi-save me-1"></i>Modificar resultado';
        // Agregar botón resetear si no existe
        if (!card.querySelector('.btn-resetear')) {
          const resetBtn = document.createElement('button');
          resetBtn.className = 'btn btn-outline-secondary btn-sm w-100 mt-1 btn-resetear';
          resetBtn.dataset.id = id;
          resetBtn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Resetear';
          resetBtn.addEventListener('click', handleResetear);
          this.parentNode.appendChild(resetBtn);
        }
      }
    } catch(e) { showToast('Error de red', false); }
    this.disabled = false;
  });
});

async function handleResetear() {
  if (!confirm('¿Resetear el resultado de este partido?')) return;
  const id = this.dataset.id;
  const card = document.getElementById('card-' + id);
  try {
    const res = await fetch('/admin/resetear', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ partido_id: id })
    });
    const data = await res.json();
    showToast(data.msg, data.ok);
    if (data.ok) {
      card.querySelector('.card-header').className = 'card-header py-2 bg-secondary text-white';
      card.querySelector('.card-header .badge').textContent = 'Pendiente';
      card.querySelector('.res-local').value = '';
      card.querySelector('.res-visit').value = '';
      this.remove();
    }
  } catch(e) { showToast('Error de red', false); }
}

document.querySelectorAll('.btn-resetear').forEach(btn => {
  btn.addEventListener('click', handleResetear);
});
</script>

<%- include('../partials/footer') %>
