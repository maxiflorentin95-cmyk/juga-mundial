<%- include('partials/header') %>

<!-- AD SLOT TOP -->
<div class="ad-slot d-none d-md-flex justify-content-center mb-3">
  <div class="ad-placeholder" style="width:728px;height:90px;">
    <span class="text-muted small">Publicidad 728×90</span>
  </div>
</div>
<div class="ad-slot d-flex d-md-none justify-content-center mb-3">
  <div class="ad-placeholder" style="width:320px;height:50px;">
    <span class="text-muted small">Publicidad 320×50</span>
  </div>
</div>

<!-- Título -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-bold mb-0">Dashboard</h2>
    <p class="text-muted mb-0 small">
      <i class="bi bi-calendar3"></i>
      <%= new Date(hoy + 'T12:00:00').toLocaleDateString('es-AR', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <div class="text-center px-3 py-2 bg-primary bg-opacity-10 rounded-3 border border-primary">
      <div class="fw-bold text-primary fs-4"><%= usuario.puntos_total %></div>
      <div class="small text-muted">mis puntos</div>
    </div>
    <div class="text-center px-3 py-2 bg-warning bg-opacity-10 rounded-3 border border-warning">
      <div class="fw-bold text-warning fs-4">#<%= miPosicion %></div>
      <div class="small text-muted">ranking</div>
    </div>
  </div>
</div>

<div class="row g-4">

  <!-- ── Col izquierda ─────────────────────────────────────── -->
  <div class="col-12 col-lg-8">

    <!-- Partidos de hoy -->
    <% if (partidosHoy.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-primary text-white fw-bold">
        <i class="bi bi-calendar-check-fill me-2"></i>Partidos de Hoy
        <span class="badge bg-white text-primary ms-2"><%= partidosHoy.length %></span>
      </div>
      <div class="card-body p-0">
        <% partidosHoy.forEach(p => { %>
        <%
          const pron = pronMap[p.id];
          const ahora = new Date();
          const matchTime = new Date(p.fecha + 'T' + p.hora + ':00');
          const cerrado = (matchTime - ahora) < 60 * 60 * 1000;
        %>
        <div class="partido-row border-bottom px-3 py-3">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3 flex-grow-1">
              <div class="text-center" style="min-width:80px">
                <div class="fw-bold"><%= p.local_bandera %> <%= p.local_corto %></div>
              </div>
              <% if (p.estado === 'finalizado') { %>
                <div class="score-box bg-dark text-white px-3 py-1 rounded fw-bold">
                  <%= p.goles_local %> – <%= p.goles_visitante %>
                </div>
              <% } else { %>
                <div class="text-center text-muted small">
                  <div class="fw-bold"><%= p.hora %> <small class="text-muted">PY</small></div>
                  <div><%- cerrado ? '<span class="badge bg-danger">Cerrado</span>' : '<span class="badge bg-success">Abierto</span>' %></div>
                </div>
              <% } %>
              <div class="text-center" style="min-width:80px">
                <div class="fw-bold"><%= p.visit_corto %> <%= p.visit_bandera %></div>
              </div>
            </div>
            <div class="ms-auto">
              <% if (pron) { %>
                <span class="badge bg-success">✓ <%= pron.goles_local %>–<%= pron.goles_visitante %></span>
                <% if (p.estado === 'finalizado') { %>
                  <span class="badge bg-<%= pron.puntos_obtenidos === 3 ? 'warning text-dark' : pron.puntos_obtenidos === 1 ? 'primary' : 'secondary' %> ms-1">
                    +<%= pron.puntos_obtenidos %> pts
                  </span>
                <% } %>
              <% } else if (!cerrado) { %>
                <a href="/pronosticos" class="btn btn-outline-primary btn-sm">Pronosticar</a>
              <% } else { %>
                <span class="badge bg-secondary">Sin pronóstico</span>
              <% } %>
            </div>
          </div>
          <div class="text-muted small mt-1">
            <i class="bi bi-geo-alt"></i> <%= p.estadio %>, <%= p.ciudad %> · Grupo <%= p.grupo %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } else { %>
    <div class="alert alert-info d-flex align-items-center mb-4">
      <i class="bi bi-info-circle-fill me-2 fs-5"></i>
      <div>No hay partidos programados para hoy.</div>
    </div>
    <% } %>

    <!-- Próximos partidos -->
    <% if (proximos.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-clock-fill me-2"></i>Próximos Partidos
      </div>
      <div class="card-body p-0">
        <% proximos.forEach(p => { %>
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
          <div>
            <span class="fw-semibold"><%= p.local_bandera %> <%= p.local_nombre %> vs <%= p.visit_nombre %> <%= p.visit_bandera %></span>
            <div class="text-muted small">
              <%= new Date(p.fecha + 'T12:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
              <%= p.hora %> PY · Grupo <%= p.grupo %>
            </div>
          </div>
          <a href="/pronosticos" class="btn btn-sm btn-outline-secondary">Pronosticar</a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Últimos resultados -->
    <% if (resultados.length > 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-success text-white fw-bold">
        <i class="bi bi-check2-circle me-2"></i>Últimos Resultados
      </div>
      <div class="card-body p-0">
        <% resultados.forEach(p => { %>
        <div class="d-flex align-items-center px-3 py-2 border-bottom">
          <div class="flex-grow-1">
            <span class="fw-semibold">
              <%= p.local_bandera %> <%= p.local_nombre %>
              <span class="badge bg-dark mx-2"><%= p.goles_local %> – <%= p.goles_visitante %></span>
              <%= p.visit_nombre %> <%= p.visit_bandera %>
            </span>
            <div class="text-muted small">
              Grupo <%= p.grupo %> ·
              <%= new Date(p.fecha + 'T12:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

  </div>

  <!-- ── Col derecha ─────────────────────────────────────── -->
  <div class="col-12 col-lg-4">

    <!-- Mini ranking -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-trophy-fill me-2"></i>Top 5 Ranking
      </div>
      <div class="card-body p-0">
        <% topRanking.forEach((u, i) => { %>
        <div class="d-flex align-items-center px-3 py-2 border-bottom">
          <span class="badge rounded-pill me-2
            <%= i===0 ? 'bg-warning text-dark' : i===1 ? 'bg-secondary' : i===2 ? 'bg-danger' : 'bg-light text-dark' %>
            " style="width:28px"><%= i+1 %></span>
          <span class="flex-grow-1 fw-<%= u.id === usuario.id ? 'bold text-primary' : 'normal' %>">
            <%= u.username %>
            <% if (u.id === usuario.id) { %> <span class="badge bg-primary ms-1">vos</span><% } %>
          </span>
          <span class="fw-bold"><%= u.puntos_total %> <small class="text-muted fw-normal">pts</small></span>
        </div>
        <% }) %>
        <div class="px-3 py-2 text-center">
          <a href="/ranking" class="btn btn-sm btn-outline-warning w-100">Ver ranking completo</a>
        </div>
      </div>
    </div>

    <!-- AD SLOT lateral -->
    <div class="ad-slot d-none d-lg-flex justify-content-center mb-4">
      <div class="ad-placeholder" style="width:300px;height:250px;">
        <span class="text-muted small">Publicidad 300×250</span>
      </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-lightning-fill me-2"></i>Accesos Rápidos
      </div>
      <div class="card-body d-grid gap-2">
        <a href="/pronosticos" class="btn btn-primary">
          <i class="bi bi-pencil-square me-2"></i>Cargar pronósticos
        </a>
        <a href="/grupos" class="btn btn-outline-secondary">
          <i class="bi bi-grid-3x3-gap me-2"></i>Ver todos los grupos
        </a>
        <a href="/ranking" class="btn btn-outline-warning">
          <i class="bi bi-trophy me-2"></i>Ranking general
        </a>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
