<%- include('partials/header') %>

<!-- AD SLOT TOP -->
<div class="ad-slot d-none d-md-flex justify-content-center mb-3">
  <div class="ad-placeholder" style="width:728px;height:90px;">
    <span class="text-muted small">Publicidad 728×90</span>
  </div>
</div>
<div class="ad-slot d-flex d-md-none justify-content-center mb-3">
  <div class="ad-placeholder" style="width:320px;height:50px;">
    <span class="text-muted small">Publicidad 320×50</span>
  </div>
</div>

<!-- Título -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div>
    <h2 class="fw-bold mb-0">Dashboard</h2>
    <p class="text-muted mb-0 small">
      <i class="bi bi-calendar3"></i>
      <%= new Date(hoy + 'T12:00:00').toLocaleDateString('es-AR', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <div class="text-center px-3 py-2 bg-primary bg-opacity-10 rounded-3 border border-primary">
      <div class="fw-bold text-primary fs-4"><%= usuario.puntos_total %></div>
      <div class="small text-muted">mis puntos</div>
    </div>
    <div class="text-center px-3 py-2 bg-warning bg-opacity-10 rounded-3 border border-warning">
      <div class="fw-bold text-warning fs-4">#<%= miPosicion %></div>
      <div class="small text-muted">ranking</div>
    </div>
  </div>
</div>

<div class="row g-4">

  <!-- ── Col izquierda ─────────────────────────────────────── -->
  <div class="col-12 col-lg-8">

    <!-- Partidos de hoy -->
    <% if (partidosHoy.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-primary text-white fw-bold">
        <i class="bi bi-calendar-check-fill me-2"></i>Partidos de Hoy
        <span class="badge bg-white text-primary ms-2"><%= partidosHoy.length %></span>
      </div>
      <div class="card-body p-0">
        <% partidosHoy.forEach(p => { %>
        <%
          const pron = pronMap[p.id];
          const ahora = new Date();
          // hora almacenada en hora Paraguay (UTC-3 fijo, Ley 7354/2024)
          const matchTime = new Date(`${p.fecha}T${p.hora}:00-03:00`);
          const cerrado = ahora >= matchTime;
        %>
        <div class="partido-row border-bottom px-3 py-3">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3 flex-grow-1">
              <div class="text-center" style="min-width:80px">
                <div class="fw-bold"><%= p.local_bandera %> <%= p.local_corto %></div>
              </div>
              <% if (p.estado === 'finalizado') { %>
                <div class="score-box bg-dark text-white px-3 py-1 rounded fw-bold">
                  <%= p.goles_local %> – <%= p.goles_visitante %>
                </div>
              <% } else { %>
                <div class="text-center text-muted small">
                  <div class="fw-bold"><%= p.hora %> <small class="text-muted">PY</small></div>
                  <div><%- cerrado ? '<span class="badge bg-danger">Cerrado</span>' : '<span class="badge bg-success">Abierto</span>' %></div>
                </div>
              <% } %>
              <div class="text-center" style="min-width:80px">
                <div class="fw-bold"><%= p.visit_corto %> <%= p.visit_bandera %></div>
              </div>
            </div>
            <div class="ms-auto">
              <% if (pron) { %>
                <span class="badge bg-success">✓ <%= pron.goles_local %>–<%= pron.goles_visitante %></span>
                <% if (p.estado === 'finalizado') { %>
                  <span class="badge bg-<%= pron.puntos_obtenidos === 5 ? 'warning text-dark' : pron.puntos_obtenidos === 3 ? 'success' : pron.puntos_obtenidos === 2 ? 'primary' : 'secondary' %> ms-1">
                    +<%= pron.puntos_obtenidos %> pts
                  </span>
                <% } %>
              <% } else if (!cerrado) { %>
                <a href="/pronosticos" class="btn btn-outline-primary btn-sm">Pronosticar</a>
              <% } else { %>
                <span class="badge bg-secondary">Sin pronóstico</span>
              <% } %>
            </div>
          </div>
          <div class="text-muted small mt-1">
            <i class="bi bi-geo-alt"></i> <%= p.estadio %>, <%= p.ciudad %> · Grupo <%= p.grupo %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } else { %>
    <div class="alert alert-info d-flex align-items-center mb-4">
      <i class="bi bi-info-circle-fill me-2 fs-5"></i>
      <div>No hay partidos programados para hoy.</div>
    </div>
    <% } %>

    <!-- Próximos partidos -->
    <% if (proximos.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-clock-fill me-2"></i>Próximos Partidos
      </div>
      <div class="card-body p-0">
        <% proximos.forEach(p => { %>
        <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
          <div>
            <span class="fw-semibold"><%= p.local_bandera %> <%= p.local_nombre %> vs <%= p.visit_nombre %> <%= p.visit_bandera %></span>
            <div class="text-muted small">
              <%= new Date(p.fecha + 'T12:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
              <%= p.hora %> PY · Grupo <%= p.grupo %>
            </div>
          </div>
          <a href="/pronosticos" class="btn btn-sm btn-outline-secondary">Pronosticar</a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Últimos resultados -->
    <% if (resultados.length > 0) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-success text-white fw-bold">
        <i class="bi bi-check2-circle me-2"></i>Últimos Resultados
      </div>
      <div class="card-body p-0">
        <% resultados.forEach(p => { %>
        <div class="d-flex align-items-center px-3 py-2 border-bottom">
          <div class="flex-grow-1">
            <span class="fw-semibold">
              <%= p.local_bandera %> <%= p.local_nombre %>
              <span class="badge bg-dark mx-2"><%= p.goles_local %> – <%= p.goles_visitante %></span>
              <%= p.visit_nombre %> <%= p.visit_bandera %>
            </span>
            <div class="text-muted small">
              Grupo <%= p.grupo %> ·
              <%= new Date(p.fecha + 'T12:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
            </div>
          </div>
          <a href="/historial?partido=<%= p.id %>" class="btn btn-sm btn-outline-info ms-2" title="Ver pronósticos">
            <i class="bi bi-eye"></i>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

  </div>

  <!-- ── Col derecha ─────────────────────────────────────── -->
  <div class="col-12 col-lg-4">

    <!-- Mini ranking -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-warning text-dark fw-bold">
        <i class="bi bi-trophy-fill me-2"></i>Top 5 Ranking
      </div>
      <div class="card-body p-0">
        <% topRanking.forEach((u, i) => { %>
        <div class="d-flex align-items-center px-3 py-2 border-bottom">
          <span class="badge rounded-pill me-2
            <%= i===0 ? 'bg-warning text-dark' : i===1 ? 'bg-secondary' : i===2 ? 'bg-danger' : 'bg-light text-dark' %>
            " style="width:28px"><%= i+1 %></span>
          <span class="flex-grow-1 fw-<%= u.id === usuario.id ? 'bold text-primary' : 'normal' %>">
            <%= u.username %>
            <% if (u.id === usuario.id) { %> <span class="badge bg-primary ms-1">vos</span><% } %>
          </span>
          <span class="fw-bold"><%= u.puntos_total %> <small class="text-muted fw-normal">pts</small></span>
        </div>
        <% }) %>
        <div class="px-3 py-2 text-center">
          <a href="/ranking" class="btn btn-sm btn-outline-warning w-100">Ver ranking completo</a>
        </div>
      </div>
    </div>

    <!-- AD SLOT lateral -->
    <div class="ad-slot d-none d-lg-flex justify-content-center mb-4">
      <div class="ad-placeholder" style="width:300px;height:250px;">
        <span class="text-muted small">Publicidad 300×250</span>
      </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white fw-bold">
        <i class="bi bi-lightning-fill me-2"></i>Accesos Rápidos
      </div>
      <div class="card-body d-grid gap-2">
        <a href="/pronosticos" class="btn btn-primary">
          <i class="bi bi-pencil-square me-2"></i>Cargar pronósticos
        </a>
        <a href="/historial" class="btn btn-outline-info">
          <i class="bi bi-clock-history me-2"></i>Historial de partidos
        </a>
        <a href="/grupos" class="btn btn-outline-secondary">
          <i class="bi bi-grid-3x3-gap me-2"></i>Ver todos los grupos
        </a>
        <a href="/ranking" class="btn btn-outline-warning">
          <i class="bi bi-trophy me-2"></i>Ranking general
        </a>
      </div>
    </div>

  </div>
</div>

<!-- ── STATS GLOBALES ────────────────────────────────────── -->
<hr class="my-4">
<h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Stats de la Liga</h5>
<div class="row g-3">

  <!-- 🔥 Termómetro de la Comunidad -->
  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header fw-bold py-2" style="background:#fd7e14;color:#fff">
        🔥 Termómetro de la Comunidad
      </div>
      <div class="card-body">
        <% if (termometro.length === 0) { %>
          <p class="text-muted small mb-0">No hay partidos hoy.</p>
        <% } else { %>
          <% termometro.forEach(p => { %>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="small fw-semibold"><%= p.local_bandera %> <%= p.local_corto %> vs <%= p.visit_corto %> <%= p.visit_bandera %></span>
              <span class="text-muted" style="font-size:.72rem"><%= p.total_votos %> votos</span>
            </div>
            <% if (p.total_votos === 0) { %>
              <div class="text-muted small fst-italic">Sin pronósticos aún</div>
            <% } else { %>
              <div class="d-flex rounded overflow-hidden" style="height:18px;font-size:.7rem">
                <% if (p.pct_local > 0) { %>
                <div class="d-flex align-items-center justify-content-center bg-primary text-white fw-bold" style="width:<%= p.pct_local %>%"><%= p.pct_local %>%</div>
                <% } %>
                <% if (p.pct_empate > 0) { %>
                <div class="d-flex align-items-center justify-content-center bg-secondary text-white fw-bold" style="width:<%= p.pct_empate %>%"><%= p.pct_empate %>%</div>
                <% } %>
                <% if (p.pct_visita > 0) { %>
                <div class="d-flex align-items-center justify-content-center bg-danger text-white fw-bold" style="width:<%= p.pct_visita %>%"><%= p.pct_visita %>%</div>
                <% } %>
              </div>
              <div class="d-flex justify-content-between mt-1" style="font-size:.7rem">
                <span class="text-primary fw-semibold"><%= p.local_corto %> <%= p.pct_local %>%</span>
                <span class="text-secondary">Empate <%= p.pct_empate %>%</span>
                <span class="text-danger fw-semibold"><%= p.pct_visita %>% <%= p.visit_corto %></span>
              </div>
            <% } %>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 📈 Jornada Perfecta -->
  <div class="col-12 col-sm-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header fw-bold py-2 bg-success text-white">
        📈 Jornada Perfecta
        <% if (fechaJornada) { %>
          <span class="fw-normal ms-1" style="font-size:.78rem">
            (<%= new Date(fechaJornada + 'T12:00:00').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>)
          </span>
        <% } %>
      </div>
      <div class="card-body">
        <% if (jornadaPerfecta.length === 0) { %>
          <p class="text-muted small mb-0">Aún no hay partidos finalizados.</p>
        <% } else { %>
          <% const iconos = ['🥇','🥈','🥉']; %>
          <% jornadaPerfecta.forEach((u, i) => { %>
          <div class="d-flex align-items-center gap-2 py-2 <%= i < jornadaPerfecta.length-1 ? 'border-bottom' : '' %>">
            <span class="fs-5"><%= iconos[i] %></span>
            <div class="flex-grow-1">
              <a href="/perfil/<%= u.username %>" class="text-decoration-none fw-semibold text-dark"><%= u.username %></a>
              <div class="text-muted" style="font-size:.75rem"><%= u.total_prons %> pronósticos · <span class="text-warning fw-bold"><%= u.exactos %> 🎯</span></div>
            </div>
            <div class="fw-bold text-success fs-5">+<%= u.pts_jornada %></div>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- 🫣 El Mufa -->
  <div class="col-12 col-sm-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header fw-bold py-2 text-white" style="background:#dc3545">
        🫣 El Mufa
      </div>
      <div class="card-body text-center">
        <% if (!mufa) { %>
          <p class="text-muted small mb-0">Aún no hay partidos finalizados.</p>
        <% } else { %>
          <div class="mb-2">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold text-white"
              style="width:70px;height:70px;background:#dc3545;font-size:1.8rem">
              <%= mufa.username.charAt(0).toUpperCase() %>
            </div>
          </div>
          <div class="fw-bold fs-5 mb-0">
            <a href="/perfil/<%= mufa.username %>" class="text-decoration-none text-dark"><%= mufa.username %></a>
          </div>
          <div class="text-muted small mb-3">apostó por el equipo perdedor</div>
          <div class="display-4 fw-bold text-danger"><%= mufa.veces_mufa %></div>
          <div class="fw-semibold text-muted">veces 😬</div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ⚡ El Inquebrantable -->
  <div class="col-12 col-sm-6 col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header fw-bold py-2 text-white" style="background:#6f42c1">
        ⚡ El Inquebrantable
      </div>
      <div class="card-body text-center">
        <% if (!rachaLider || rachaLider.streakActual === 0) { %>
          <p class="text-muted small mb-0">
            <% if (!rachaLider) { %>Aún no hay datos suficientes.<% } else { %>Nadie tiene una racha activa ahora mismo.<% } %>
          </p>
        <% } else { %>
          <div class="mb-2" style="font-size:2.8rem;line-height:1">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold text-white"
              style="width:70px;height:70px;background:#6f42c1;font-size:1.8rem">
              <%= rachaLider.username.charAt(0).toUpperCase() %>
            </div>
          </div>
          <div class="fw-bold fs-5 mb-0">
            <a href="/perfil/<%= rachaLider.username %>" class="text-decoration-none text-dark"><%= rachaLider.username %></a>
          </div>
          <div class="text-muted small mb-3">lleva</div>
          <div class="display-4 fw-bold" style="color:#6f42c1"><%= rachaLider.streakActual %></div>
          <div class="fw-semibold text-muted">aciertos seguidos 🔥</div>
          <% if (rachaLider.streakMax > rachaLider.streakActual) { %>
          <div class="mt-2 small text-muted">Mejor racha histórica: <strong><%= rachaLider.streakMax %></strong></div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>

</div>

<!-- ── Partidos más acertados / más difíciles ─────────────────── -->
<% if (masAcertados.length > 0) { %>
<% const faseLabel = f => f === 'grupos' ? 'Fase de Grupos' : f === 'octavos' ? 'Octavos de Final' : f === 'cuartos' ? 'Cuartos de Final' : f === 'semis' ? 'Semifinal' : f === 'final' ? 'Final' : f; %>
<div class="row g-4 mt-1">

  <div class="col-12 col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header fw-bold py-2 text-white" style="background:#198754">
        ✅ Partidos más acertados
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
          <thead class="table-dark" style="font-size:.75rem">
            <tr>
              <th>Partido</th>
              <th class="text-center">Real</th>
              <th class="text-center text-warning">Exactos</th>
              <th class="text-center text-info">No exactos</th>
              <th class="text-center">Con puntos</th>
            </tr>
          </thead>
          <tbody style="font-size:.82rem">
            <% masAcertados.forEach(p => { %>
            <tr>
              <td>
                <a href="/historial?partido=<%= p.id %>" class="text-decoration-none fw-semibold text-dark">
                  <%= p.local_bandera %> <%= p.local_nombre %> vs <%= p.visit_nombre %> <%= p.visit_bandera %>
                </a>
                <div class="text-muted" style="font-size:.7rem"><%= faseLabel(p.fase) %><% if (p.grupo) { %> · Grupo <%= p.grupo %><% } %></div>
              </td>
              <td class="text-center fw-bold"><%= p.goles_local %>-<%= p.goles_visitante %></td>
              <td class="text-center fw-bold text-warning"><%= p.exactos %></td>
              <td class="text-center fw-bold text-info"><%= p.no_exactos %></td>
              <td class="text-center">
                <span class="badge bg-success"><%= p.con_puntos %>/<%= p.total %></span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header fw-bold py-2 text-white" style="background:#dc3545">
        💀 Partidos más difíciles
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
          <thead class="table-dark" style="font-size:.75rem">
            <tr>
              <th>Partido</th>
              <th class="text-center">Real</th>
              <th class="text-center text-warning">Exactos</th>
              <th class="text-center text-info">No exactos</th>
              <th class="text-center">Con puntos</th>
            </tr>
          </thead>
          <tbody style="font-size:.82rem">
            <% masDificiles.forEach(p => { %>
            <tr>
              <td>
                <a href="/historial?partido=<%= p.id %>" class="text-decoration-none fw-semibold text-dark">
                  <%= p.local_bandera %> <%= p.local_nombre %> vs <%= p.visit_nombre %> <%= p.visit_bandera %>
                </a>
                <div class="text-muted" style="font-size:.7rem"><%= faseLabel(p.fase) %><% if (p.grupo) { %> · Grupo <%= p.grupo %><% } %></div>
              </td>
              <td class="text-center fw-bold"><%= p.goles_local %>-<%= p.goles_visitante %></td>
              <td class="text-center fw-bold text-warning"><%= p.exactos %></td>
              <td class="text-center fw-bold text-info"><%= p.no_exactos %></td>
              <td class="text-center">
                <span class="badge bg-danger"><%= p.con_puntos %>/<%= p.total %></span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
<% } %>

<!-- ── Modal Trivia del Día ──────────────────────────────────── -->
<div class="modal fade" id="triviaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header py-2 text-white" style="background:#e67e22">
        <h5 class="modal-title fw-bold"><i class="bi bi-patch-question-fill me-2"></i>Trivia del Día</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="trivia-modal-body">
        <div class="text-center py-4"><div class="spinner-border text-warning"></div></div>
      </div>
      <div class="modal-footer py-2 justify-content-between">
        <span class="text-muted small" id="trivia-modal-hint"></span>
        <a href="/trivia" class="btn btn-sm" style="background:#e67e22;color:#fff">
          Ver pregunta completa <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
(async function () {
  const STORAGE_KEY = 'trivia_popup_visto_' + '<%= hoy %>';
  if (localStorage.getItem(STORAGE_KEY)) return; // ya se mostró hoy

  try {
    const data = await fetch('/trivia/hoy').then(r => r.json());
    if (!data.ok || !data.pendiente) return; // no hay pregunta o ya respondió

    localStorage.setItem(STORAGE_KEY, '1');

    // Mostrar modal
    const modal = new bootstrap.Modal(document.getElementById('triviaModal'));
    document.getElementById('trivia-modal-hint').textContent =
      'Cerrá para responder desde /trivia (penaliza el puntaje máximo)';
    document.getElementById('trivia-modal-body').innerHTML = `
      <p class="text-center text-muted small mb-2">Tenés una pregunta pendiente de hoy.</p>
      <div class="alert alert-warning py-2 text-center mb-0">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Cada vez que lo cerrás sin responder, tu puntaje máximo baja.<br>
        <strong>¡Respondé ahora para sumar hasta 10 pts!</strong>
      </div>`;
    modal.show();
  } catch (_) {}
})();
</script>

<%- include('partials/footer') %>
