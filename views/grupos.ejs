<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0">Grupos – Fase de Grupos</h2>
</div>

<!-- AD SLOT -->
<div class="ad-slot d-none d-md-flex justify-content-center mb-4">
  <div class="ad-placeholder" style="width:728px;height:90px;">
    <span class="text-muted small">Publicidad 728×90</span>
  </div>
</div>

<div class="row g-3">
  <% grupos.forEach(g => { %>
  <div class="col-12 col-sm-6 col-xl-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header d-flex justify-content-between align-items-center bg-dark text-white">
        <span class="fw-bold fs-5">Grupo <%= g %></span>
        <a href="/grupos/<%= g %>" class="btn btn-sm btn-outline-light">Ver detalle</a>
      </div>
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-secondary">
            <tr>
              <th class="ps-3">#</th>
              <th>Equipo</th>
              <th class="text-center">PJ</th>
              <th class="text-center">PTS</th>
              <th class="text-center d-none d-sm-table-cell">GD</th>
            </tr>
          </thead>
          <tbody>
            <% tablas[g].forEach((row, idx) => { %>
            <tr class="<%= idx < 2 ? 'table-success bg-opacity-25' : '' %>">
              <td class="ps-3 text-muted small"><%= idx+1 %></td>
              <td>
                <span class="me-1"><%= row.equipo.bandera %></span>
                <span class="fw-semibold small"><%= row.equipo.nombre_corto || row.equipo.nombre %></span>
              </td>
              <td class="text-center small"><%= row.pj %></td>
              <td class="text-center fw-bold"><%= row.pts %></td>
              <td class="text-center small d-none d-sm-table-cell">
                <span class="<%= row.gd > 0 ? 'text-success' : row.gd < 0 ? 'text-danger' : '' %>">
                  <%= row.gd > 0 ? '+' : '' %><%= row.gd %>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer bg-transparent text-muted small py-1">
        <i class="bi bi-info-circle"></i> Verde = clasifican
      </div>
    </div>
  </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
