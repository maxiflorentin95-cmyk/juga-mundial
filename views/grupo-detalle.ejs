<%- include('partials/header') %>

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
  <a href="/grupos" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Grupos</a>
  <h2 class="fw-bold mb-0">Grupo <%= grupo %></h2>
  <div class="ms-auto d-flex gap-1 flex-wrap">
    <% letras.forEach(l => { %>
    <a href="/grupos/<%= l %>?usuario=<%= selUser.id %>"
       class="btn btn-sm <%= l === grupo ? 'btn-dark' : 'btn-outline-secondary' %>"><%= l %></a>
    <% }) %>
  </div>
</div>

<div class="row g-4">

  <!-- ── Tabla Real ── -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white py-2 d-flex align-items-center gap-2">
        <i class="bi bi-table"></i>
        <span class="fw-bold">Tabla Real</span>
        <span class="badge bg-secondary ms-auto">Oficial</span>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-secondary">
            <tr>
              <th class="ps-3" style="width:28px">#</th>
              <th>Equipo</th>
              <th class="text-center px-1">PJ</th>
              <th class="text-center px-1">G</th>
              <th class="text-center px-1">E</th>
              <th class="text-center px-1">P</th>
              <th class="text-center px-1">GD</th>
              <th class="text-center px-1 fw-bold">PTS</th>
            </tr>
          </thead>
          <tbody>
            <% tablaReal.forEach((row, idx) => { %>
            <tr class="<%= idx < 2 ? 'table-success' : '' %>">
              <td class="ps-3 text-muted small"><%= idx+1 %></td>
              <td>
                <span class="me-1"><%= row.equipo.bandera %></span>
                <span class="fw-semibold small"><%= row.equipo.nombre_corto || row.equipo.nombre %></span>
              </td>
              <td class="text-center small"><%= row.pj %></td>
              <td class="text-center small"><%= row.pg %></td>
              <td class="text-center small"><%= row.pe %></td>
              <td class="text-center small"><%= row.pp %></td>
              <td class="text-center small <%= row.gd > 0 ? 'text-success' : row.gd < 0 ? 'text-danger' : '' %>">
                <%= row.gd > 0 ? '+' : '' %><%= row.gd %>
              </td>
              <td class="text-center fw-bold"><%= row.pts %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer bg-transparent py-1 px-3 text-muted" style="font-size:.72rem">
        <i class="bi bi-circle-fill text-success" style="font-size:.4rem;vertical-align:middle"></i> Verde = clasifican
      </div>
    </div>
  </div>

  <!-- ── Tabla Pronosticada ── -->
  <div class="col-12 col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-primary text-white py-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
          <i class="bi bi-magic"></i>
          <span class="fw-bold">Tabla Pronosticada</span>
          <form method="GET" action="/grupos/<%= grupo %>" class="ms-auto">
            <select name="usuario" class="form-select form-select-sm" style="max-width:140px" onchange="this.form.submit()">
              <% usuarios.forEach(u => { %>
              <option value="<%= u.id %>" <%= selUser.id === u.id ? 'selected' : '' %>><%= u.username %></option>
              <% }) %>
            </select>
          </form>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-secondary">
            <tr>
              <th class="ps-3" style="width:36px">#</th>
              <th>Equipo</th>
              <th class="text-center px-1">PJ</th>
              <th class="text-center px-1">G</th>
              <th class="text-center px-1">E</th>
              <th class="text-center px-1">P</th>
              <th class="text-center px-1">GD</th>
              <th class="text-center px-1 fw-bold">PTS</th>
            </tr>
          </thead>
          <tbody>
            <% tablaProno.forEach((row, idx) => { %>
            <% const posReal = tablaReal.findIndex(r => r.equipo.id === row.equipo.id); %>
            <% const diff = posReal - idx; %>
            <tr class="<%= idx < 2 ? 'table-success' : '' %>">
              <td class="ps-3">
                <span class="text-muted small"><%= idx+1 %></span>
                <% if (diff > 0) { %><i class="bi bi-arrow-up-short text-success small"></i>
                <% } else if (diff < 0) { %><i class="bi bi-arrow-down-short text-danger small"></i>
                <% } %>
              </td>
              <td>
                <span class="me-1"><%= row.equipo.bandera %></span>
                <span class="fw-semibold small"><%= row.equipo.nombre_corto || row.equipo.nombre %></span>
                <% if (row.sin_pron > 0) { %>
                <span class="badge bg-warning text-dark ms-1" style="font-size:.58rem">?<%= row.sin_pron %></span>
                <% } %>
              </td>
              <td class="text-center small"><%= row.pj %></td>
              <td class="text-center small"><%= row.pg %></td>
              <td class="text-center small"><%= row.pe %></td>
              <td class="text-center small"><%= row.pp %></td>
              <td class="text-center small <%= row.gd > 0 ? 'text-success' : row.gd < 0 ? 'text-danger' : '' %>">
                <%= row.gd > 0 ? '+' : '' %><%= row.gd %>
              </td>
              <td class="text-center fw-bold"><%= row.pts %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-footer bg-transparent py-1 px-3 text-muted" style="font-size:.72rem">
        <i class="bi bi-arrow-up-short text-success"></i>/<i class="bi bi-arrow-down-short text-danger"></i> vs tabla real
        &nbsp;·&nbsp;<span class="badge bg-warning text-dark" style="font-size:.58rem">?N</span> sin pronóstico
      </div>
    </div>
  </div>

  <!-- ── Partidos del grupo ── -->
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white py-2 fw-bold">
        <i class="bi bi-calendar3 me-2"></i>Partidos del Grupo <%= grupo %>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-secondary">
            <tr>
              <th class="ps-3">Fecha</th>
              <th class="text-end pe-1">Local</th>
              <th class="text-center px-2">Resultado</th>
              <th class="ps-1">Visitante</th>
              <th class="text-center d-none d-md-table-cell">Estado</th>
            </tr>
          </thead>
          <tbody>
            <% partidos.forEach(p => { %>
            <tr>
              <td class="ps-3 text-muted small text-nowrap">
                <%= new Date(p.fecha+'T12:00:00Z').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
                · <%= p.hora %>
              </td>
              <td class="text-end pe-1">
                <span class="fw-semibold small"><%= p.local_corto %></span>
                <span class="ms-1 fs-5 lh-1"><%= p.local_bandera %></span>
              </td>
              <td class="text-center px-2">
                <% if (p.estado === 'finalizado') { %>
                <span class="badge bg-dark px-2 fw-bold"><%= p.goles_local %>–<%= p.goles_visitante %></span>
                <% } else { %>
                <span class="text-muted small">vs</span>
                <% } %>
              </td>
              <td class="ps-1">
                <span class="fs-5 lh-1"><%= p.visit_bandera %></span>
                <span class="fw-semibold small ms-1"><%= p.visit_corto %></span>
              </td>
              <td class="text-center d-none d-md-table-cell">
                <span class="badge <%= p.estado==='finalizado' ? 'bg-success' : 'bg-secondary' %>">
                  <%= p.estado==='finalizado' ? 'Final' : 'Pendiente' %>
                </span>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
