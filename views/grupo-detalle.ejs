<%- include('partials/header') %>

<div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
  <a href="/grupos" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <h2 class="fw-bold mb-0">Grupo <%= grupo %></h2>
</div>

<div class="row g-3">
  <!-- Tabla de posiciones -->
  <div class="col-12 col-md-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-dark text-white fw-bold py-2">
        <i class="bi bi-list-ol me-2"></i>Posiciones
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-secondary">
              <tr>
                <th class="ps-2">#</th>
                <th>Equipo</th>
                <th class="text-center">PJ</th>
                <th class="text-center d-none d-sm-table-cell">PG</th>
                <th class="text-center d-none d-sm-table-cell">PE</th>
                <th class="text-center d-none d-sm-table-cell">PP</th>
                <th class="text-center d-none d-md-table-cell">GF</th>
                <th class="text-center d-none d-md-table-cell">GC</th>
                <th class="text-center">GD</th>
                <th class="text-center fw-bold">PTS</th>
              </tr>
            </thead>
            <tbody>
              <% tabla.forEach((row, idx) => { %>
              <tr class="<%= idx < 2 ? 'table-success' : '' %>">
                <td class="ps-2 fw-bold"><%= idx+1 %></td>
                <td>
                  <span class="me-1"><%= row.equipo.bandera %></span>
                  <span class="fw-semibold d-none d-sm-inline"><%= row.equipo.nombre %></span>
                  <span class="fw-semibold d-sm-none small"><%= row.equipo.nombre_corto || row.equipo.nombre %></span>
                </td>
                <td class="text-center small"><%= row.pj %></td>
                <td class="text-center small d-none d-sm-table-cell"><%= row.pg %></td>
                <td class="text-center small d-none d-sm-table-cell"><%= row.pe %></td>
                <td class="text-center small d-none d-sm-table-cell"><%= row.pp %></td>
                <td class="text-center small d-none d-md-table-cell"><%= row.gf %></td>
                <td class="text-center small d-none d-md-table-cell"><%= row.gc %></td>
                <td class="text-center small <%= row.gd > 0 ? 'text-success' : row.gd < 0 ? 'text-danger' : '' %>">
                  <%= row.gd > 0 ? '+' : '' %><%= row.gd %>
                </td>
                <td class="text-center fw-bold"><%= row.pts %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer text-muted small py-1 px-3">
        <i class="bi bi-circle-fill text-success" style="font-size:.5rem"></i> Verde = clasifican
      </div>
    </div>
  </div>

  <!-- Partidos -->
  <div class="col-12 col-md-7">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-primary text-white fw-bold py-2">
        <i class="bi bi-calendar3 me-2"></i>Partidos
      </div>
      <div class="card-body p-0">
        <%
          const porFecha = {};
          partidos.forEach(p => {
            if (!porFecha[p.fecha]) porFecha[p.fecha] = [];
            porFecha[p.fecha].push(p);
          });
        %>
        <% Object.entries(porFecha).forEach(([fecha, ps]) => { %>
        <div class="px-3 py-2 bg-light border-bottom">
          <small class="fw-bold text-muted text-uppercase">
            <%= new Date(fecha + 'T12:00:00').toLocaleDateString('es-AR',{weekday:'short',day:'numeric',month:'short'}) %>
          </small>
        </div>
        <% ps.forEach(p => { %>
        <div class="px-2 px-sm-3 py-2 border-bottom">
          <div class="d-flex align-items-center gap-1">
            <div class="d-flex align-items-center justify-content-end gap-1 flex-grow-1" style="min-width:0;overflow:hidden">
              <span class="fw-bold text-end small text-truncate"><%= p.local_nombre %></span>
              <span style="font-size:1.2rem;flex-shrink:0"><%= p.local_bandera %></span>
            </div>
            <div class="text-center flex-shrink-0 px-1" style="min-width:64px">
              <% if (p.estado === 'finalizado') { %>
                <span class="badge bg-dark fs-6 px-2 py-1"><%= p.goles_local %>–<%= p.goles_visitante %></span>
              <% } else { %>
                <div class="badge bg-secondary px-2 py-1 lh-sm"><%= p.hora %><br><small class="fw-normal opacity-75">PY</small></div>
              <% } %>
            </div>
            <div class="d-flex align-items-center gap-1 flex-grow-1" style="min-width:0;overflow:hidden">
              <span style="font-size:1.2rem;flex-shrink:0"><%= p.visit_bandera %></span>
              <span class="fw-bold small text-truncate"><%= p.visit_nombre %></span>
            </div>
          </div>
          <div class="text-center text-muted mt-1" style="font-size:.7rem">
            <i class="bi bi-geo-alt"></i> <%= p.ciudad %>
          </div>
        </div>
        <% }) %>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
