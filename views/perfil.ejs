<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
  <a href="/ranking" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Ranking</a>
  <div>
    <h2 class="fw-bold mb-0">
      <i class="bi bi-person-circle me-2 text-primary"></i><%= user.username %>
      <% if (esPropio) { %><span class="badge bg-primary ms-1 small align-middle">Vos</span><% } %>
    </h2>
    <div class="text-muted small">Posición actual: <strong>#<%= pos %></strong></div>
  </div>
</div>

<!-- Stats -->
<div class="row g-2 mb-4">
  <div class="col-4 col-md-2">
    <div class="card border-0 bg-primary bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-primary"><%= stats.puntos %></div>
      <div class="small text-muted">Puntos</div>
    </div>
  </div>
  <div class="col-4 col-md-2">
    <div class="card border-0 bg-warning bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-warning"><%= stats.exactos %></div>
      <div class="small text-muted">🎯 Exactos</div>
    </div>
  </div>
  <div class="col-4 col-md-2">
    <div class="card border-0 bg-success bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-success"><%= stats.diferencia %></div>
      <div class="small text-muted">≈ Diferencia</div>
    </div>
  </div>
  <div class="col-4 col-md-2">
    <div class="card border-0 bg-info bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-info"><%= stats.ganador %></div>
      <div class="small text-muted">✓ Ganador</div>
    </div>
  </div>
  <div class="col-4 col-md-2">
    <div class="card border-0 bg-secondary bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-secondary"><%= stats.fallados %></div>
      <div class="small text-muted">✗ Fallados</div>
    </div>
  </div>
  <div class="col-4 col-md-2">
    <div class="card border-0 bg-dark bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4"><%= stats.total %></div>
      <div class="small text-muted">Total</div>
    </div>
  </div>
</div>

<!-- Pronósticos especiales -->
<% if (Object.keys(espMap).length > 0) { %>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-warning text-dark fw-bold py-2">
    <i class="bi bi-stars me-2"></i>Pronósticos Especiales
  </div>
  <div class="card-body py-2">
    <div class="d-flex flex-wrap gap-3">
      <% [
        {tipo:'campeon', label:'🥇 Campeón'},
        {tipo:'segundo', label:'🥈 2do puesto'},
        {tipo:'tercero', label:'🥉 3er puesto'},
        {tipo:'goleador', label:'⚽ Goleador'},
        {tipo:'mvp', label:'🌟 MVP'},
      ].forEach(s => { %>
      <% if (espMap[s.tipo]) { %>
      <div class="text-center">
        <div class="text-muted small mb-1"><%= s.label %></div>
        <span class="badge bg-dark px-3 py-2 fs-6"><%= espMap[s.tipo] %></span>
      </div>
      <% } %>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<!-- Tabla de pronósticos -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
    <span class="fw-bold"><i class="bi bi-list-ul me-2"></i>Todos los pronósticos</span>
    <span class="badge bg-secondary"><%= prons.length %> cargados</span>
  </div>
  <% if (prons.length === 0) { %>
  <div class="card-body text-muted fst-italic">Sin pronósticos cargados.</div>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-secondary">
        <tr>
          <th class="ps-3">Fecha</th>
          <th class="text-end pe-1">Local</th>
          <th class="text-center px-1">Resultado</th>
          <th class="ps-1">Visitante</th>
          <th class="text-center">Pronós.</th>
          <th class="text-center">Pts</th>
        </tr>
      </thead>
      <tbody>
        <% prons.forEach(p => { %>
        <tr class="<%= p.puntos_obtenidos === 5 ? 'table-warning' : '' %>">
          <td class="ps-3 text-muted small text-nowrap">
            <%= new Date(p.fecha+'T12:00:00Z').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
          </td>
          <td class="text-end pe-1 small">
            <span class="fw-semibold"><%= p.local_corto %></span>
            <span class="ms-1"><%= p.local_bandera %></span>
          </td>
          <td class="text-center px-1">
            <% if (p.estado === 'finalizado') { %>
            <span class="badge bg-dark px-2"><%= p.r_local %>–<%= p.r_visit %></span>
            <% } else { %>
            <span class="text-muted small">–</span>
            <% } %>
          </td>
          <td class="ps-1 small">
            <span><%= p.visit_bandera %></span>
            <span class="fw-semibold ms-1"><%= p.visit_corto %></span>
          </td>
          <td class="text-center">
            <span class="badge bg-secondary px-2"><%= p.p_local %>–<%= p.p_visit %></span>
          </td>
          <td class="text-center">
            <% if (p.estado === 'finalizado') { %>
            <%
              const pL = parseInt(p.p_local), pV = parseInt(p.p_visit);
              const rL = parseInt(p.r_local),  rV = parseInt(p.r_visit);
              let basePts = 0;
              if (pL===rL && pV===rV) basePts=5;
              else if ((pL-pV)===(rL-rV)) basePts=3;
              else if (Math.sign(pL-pV)===Math.sign(rL-rV)) basePts=2;
              const esElimP = p.fase && p.fase !== 'grupos';
              const predEmpateP = pL === pV;
              const bonusPts = esElimP && predEmpateP && p.pron_clasif_id && p.real_clasif_id &&
                parseInt(p.pron_clasif_id)===parseInt(p.real_clasif_id) ? 1 : 0;
            %>
            <div class="d-inline-flex align-items-center gap-1">
              <span class="badge px-2
                <%= basePts===5 ? 'bg-warning text-dark' : basePts===3 ? 'bg-success' : basePts===2 ? 'bg-primary' : 'bg-secondary' %>">
                <%= basePts===5 ? '🎯' : basePts===3 ? '≈' : basePts===2 ? '✓' : '✗' %>
                <%= basePts %>
              </span>
              <% if (bonusPts > 0) { %>
              <span class="badge bg-info text-dark px-2">👊 +1</span>
              <% } %>
            </div>
            <% } else { %>
            <span class="text-muted small">–</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
