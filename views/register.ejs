<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JUGA Mundial 2026 – Registrarse</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-dark d-flex align-items-center justify-content-center min-vh-100 py-4">

<div class="login-card card shadow-lg border-0" style="max-width:420px;width:100%;">
  <div class="card-body p-4 p-md-5">
    <div class="text-center mb-4">
      <div class="display-3 mb-2">⚽</div>
      <h1 class="h3 fw-bold text-dark">Crear cuenta</h1>
      <p class="text-muted small">Unite a JUGA Mundial 2026</p>
    </div>

    <% if (error) { %>
    <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle-fill me-1"></i><%= error %></div>
    <% } %>

    <form action="/register" method="POST">
      <div class="mb-3">
        <label class="form-label fw-semibold">Nombre de usuario</label>
        <input type="text" name="username" class="form-control" placeholder="ej: futbolero99" required autofocus minlength="3">
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Email</label>
        <input type="email" name="email" class="form-control" placeholder="tu@email.com" required>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Contraseña</label>
        <input type="password" name="password" class="form-control" placeholder="mínimo 6 caracteres" required minlength="6">
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold">Confirmar contraseña</label>
        <input type="password" name="password2" class="form-control" placeholder="repetí la contraseña" required>
      </div>
      <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">
        Crear cuenta <i class="bi bi-person-plus-fill ms-1"></i>
      </button>
    </form>

    <hr class="my-4">
    <p class="text-center mb-0 text-muted small">
      ¿Ya tenés cuenta?
      <a href="/" class="fw-bold text-decoration-none">Iniciá sesión</a>
    </p>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
