<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver</a>
  <div>
    <h2 class="fw-bold mb-0"><i class="bi bi-diagram-3-fill text-warning me-2"></i>Fase Eliminatoria</h2>
    <div class="text-muted small">16avos · Octavos · Cuartos · Semis · Final</div>
  </div>
</div>

<% if (sinPartidos) { %>
<div class="card border-0 shadow-sm">
  <div class="card-body text-center py-5">
    <i class="bi bi-hourglass-split text-muted" style="font-size:3rem"></i>
    <h5 class="mt-3 text-muted">La fase eliminatoria aún no comenzó</h5>
    <p class="text-muted">Los partidos se cargarán cuando finalice la fase de grupos.</p>
    <a href="/grupos" class="btn btn-outline-primary mt-2">Ver fase de grupos</a>
  </div>
</div>

<% } else { %>

<!-- Disclaimer de puntaje -->
<div class="alert border-warning border-2 bg-warning bg-opacity-10 mb-3 py-2 px-3">
  <div class="fw-bold small mb-1"><i class="bi bi-info-circle-fill text-warning me-1"></i>Reglas de puntaje — Fase Eliminatoria</div>
  <div class="small text-muted">
    El marcador se puntúa por los <strong>90 minutos reglamentarios</strong>. Alargue y penales solo definen quién pasa.
  </div>
  <div class="d-flex flex-wrap gap-2 mt-2" style="font-size:.75rem">
    <span class="badge bg-warning text-dark">🎯 Exacto = 5 pts</span>
    <span class="badge bg-success">≈ Diferencia = 3 pts</span>
    <span class="badge bg-primary">✓ Ganador = 2 pts</span>
    <span class="badge bg-secondary">= Empate acertado = 2 pts</span>
    <span class="badge bg-info text-dark">🏅 Clasificado correcto = +2 pts</span>
  </div>
</div>

<!-- Filtro de fases -->
<% if (fasesDisponibles.length > 1) { %>
<div class="d-flex gap-2 flex-wrap mb-3">
  <a href="/eliminatoria" class="btn btn-sm <%= !faseActiva ? 'btn-dark' : 'btn-outline-dark' %>">Todas</a>
  <% fasesDisponibles.forEach(f => { %>
  <a href="/eliminatoria?fase=<%= f %>" class="btn btn-sm <%= faseActiva === f ? 'btn-warning' : 'btn-outline-secondary' %>">
    <%= FASE_LABEL[f] %>
  </a>
  <% }) %>
</div>
<% } %>

<!-- Partidos por fase -->
<% fases.forEach(fase => { %>
<div class="mb-4">
  <div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge bg-dark px-3 py-2 fs-6"><%= FASE_LABEL[fase] %></span>
    <hr class="flex-grow-1 my-0 border-secondary opacity-25">
  </div>

  <div class="card border-0 shadow-sm overflow-hidden">
    <% porFase[fase].forEach((p, idx) => { %>
    <div class="partido-card p-3 <%= idx > 0 ? 'border-top' : '' %>" data-id="<%= p.id %>">

      <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="text-center" style="min-width:52px">
          <div class="fw-bold small lh-1"><%= p.hora %></div>
          <div class="text-muted" style="font-size:.65rem">
            <%= new Date(p.fecha+'T12:00:00Z').toLocaleDateString('es-AR',{day:'numeric',month:'short'}) %>
          </div>
        </div>

        <div class="d-flex align-items-center flex-grow-1 gap-1">
          <div class="d-flex align-items-center gap-1 flex-grow-1 justify-content-end">
            <span class="fw-semibold small text-end" style="max-width:100px"><%= p.local_corto || p.local_nombre %></span>
            <span class="fs-4 lh-1"><%= p.local_bandera %></span>
          </div>
          <div class="text-center px-2" style="min-width:60px">
            <% if (p.estado === 'finalizado') { %>
            <span class="badge bg-dark px-2 py-1 fw-bold"><%= p.goles_local %>–<%= p.goles_visitante %></span>
            <% } else { %>
            <span class="text-muted fw-bold small">vs</span>
            <% } %>
          </div>
          <div class="d-flex align-items-center gap-1 flex-grow-1">
            <span class="fs-4 lh-1"><%= p.visit_bandera %></span>
            <span class="fw-semibold small" style="max-width:100px"><%= p.visit_corto || p.visit_nombre %></span>
          </div>
        </div>

        <div class="ms-auto">
          <span class="badge <%= p.estado==='finalizado' ? 'bg-success' : p.cerrado ? 'bg-secondary' : 'bg-warning text-dark' %> text-nowrap">
            <%= p.estado==='finalizado' ? 'Final' : p.cerrado ? 'En juego' : 'Abierto' %>
          </span>
        </div>
      </div>

      <div class="mt-2 ms-0 ms-md-5 ps-md-3">
        <% if (p.estado === 'finalizado') { %>
          <% if (p.pronostico) { %>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small">Tu pronóstico:</span>
            <span class="badge bg-dark px-2 py-1"><%= p.pronostico.goles_local %>–<%= p.pronostico.goles_visitante %></span>
            <span class="badge px-2 py-1
              <%= p.pronostico.puntos_obtenidos>=5 ? 'bg-warning text-dark' :
                  p.pronostico.puntos_obtenidos>=3 ? 'bg-success' :
                  p.pronostico.puntos_obtenidos>=2 ? 'bg-primary' : 'bg-secondary' %>">
              +<%= p.pronostico.puntos_obtenidos %> pts
            </span>
          </div>
          <% } else { %>
          <span class="text-muted small fst-italic">No pronosticaste este partido</span>
          <% } %>
        <% } else if (p.cerrado) { %>
          <% if (p.pronostico) { %>
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Tu pronóstico:</span>
            <span class="badge bg-dark px-2"><%= p.pronostico.goles_local %>–<%= p.pronostico.goles_visitante %></span>
            <span class="text-muted small"><i class="bi bi-lock-fill"></i></span>
          </div>
          <% } else { %>
          <span class="text-muted small fst-italic"><i class="bi bi-lock-fill"></i> No pronosticaste</span>
          <% } %>
        <% } else { %>
          <div class="d-flex align-items-center gap-2 flex-wrap input-pron"
               data-local-id="<%= p.equipo_local_id %>"
               data-visit-id="<%= p.equipo_visitante_id %>"
               data-local-nombre="<%= p.local_corto || p.local_nombre %>"
               data-visit-nombre="<%= p.visit_corto || p.visit_nombre %>"
               data-local-bandera="<%= p.local_bandera %>"
               data-visit-bandera="<%= p.visit_bandera %>"
               data-clasif-id="<%= p.pronostico && p.pronostico.clasificado_id ? p.pronostico.clasificado_id : '' %>">
            <% if (p.pronostico) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle small px-2 badge-cargado">
              <i class="bi bi-check2 me-1"></i>Cargado
            </span>
            <% } %>
            <!-- Inputs goles -->
            <div class="d-flex align-items-center gap-1">
              <input type="number" class="form-control form-control-sm text-center fw-bold pron-local"
                min="0" max="20" style="width:52px"
                value="<%= p.pronostico ? p.pronostico.goles_local : '' %>" placeholder="0">
              <span class="fw-bold text-muted">–</span>
              <input type="number" class="form-control form-control-sm text-center fw-bold pron-visit"
                min="0" max="20" style="width:52px"
                value="<%= p.pronostico ? p.pronostico.goles_visitante : '' %>" placeholder="0">
            </div>
            <!-- Selector clasificado (solo visible si empate) -->
            <div class="clasif-wrap" style="display:none">
              <select class="form-select form-select-sm sel-clasif" style="min-width:140px">
                <option value="">¿Quién clasifica?</option>
                <option value="<%= p.equipo_local_id %>"><%= p.local_bandera %> <%= p.local_corto || p.local_nombre %></option>
                <option value="<%= p.equipo_visitante_id %>"><%= p.visit_bandera %> <%= p.visit_corto || p.visit_nombre %></option>
              </select>
            </div>
            <!-- Indicador automático (solo visible si hay ganador claro) -->
            <div class="clasif-static badge bg-info text-dark" style="display:none">
              <i class="bi bi-arrow-right-circle me-1"></i>Clasifica: <span class="clasif-static-nombre"></span>
            </div>
            <button class="btn btn-sm <%= p.pronostico ? 'btn-outline-primary' : 'btn-primary' %> btn-guardar"
              data-id="<%= p.id %>"
              data-local-id="<%= p.equipo_local_id %>"
              data-visit-id="<%= p.equipo_visitante_id %>">
              <i class="bi bi-save me-1"></i><%= p.pronostico ? 'Actualizar' : 'Guardar' %>
            </button>
            <span class="msg-pron small"></span>
          </div>
          <% if (p.pronostico && p.pronostico.clasificado_id) { %>
          <div class="text-muted small mt-1">
            <i class="bi bi-arrow-right-circle me-1"></i>Clasifica:
            <% if (parseInt(p.pronostico.clasificado_id) === parseInt(p.equipo_local_id)) { %>
              <%= p.local_bandera %> <%= p.local_corto || p.local_nombre %>
            <% } else { %>
              <%= p.visit_bandera %> <%= p.visit_corto || p.visit_nombre %>
            <% } %>
          </div>
          <% } %>
        <% } %>
      </div>

    </div>
    <% }) %>
  </div>
</div>
<% }) %>

<script>
function actualizarClasif(row, esInit) {
  const gl = row.querySelector('.pron-local').value;
  const gv = row.querySelector('.pron-visit').value;
  const wrap        = row.querySelector('.clasif-wrap');
  const staticDiv   = row.querySelector('.clasif-static');
  const staticNombre = row.querySelector('.clasif-static-nombre');
  const sel         = row.querySelector('.sel-clasif');
  if (!wrap) return;

  const localId   = row.dataset.localId;
  const visitId   = row.dataset.visitId;
  const localNom  = row.dataset.localNombre;
  const visitNom  = row.dataset.visitNombre;
  const localBan  = row.dataset.localBandera;
  const visitBan  = row.dataset.visitBandera;
  const savedClasif = row.dataset.clasifId;

  const ambosRellenos = gl !== '' && gv !== '';
  const esEmpate = ambosRellenos && parseInt(gl) === parseInt(gv);

  if (esEmpate) {
    // Mostrar selector, ocultar estático
    wrap.style.display = '';
    if (staticDiv) staticDiv.style.display = 'none';
    // Si es init y hay clasificado guardado, pre-seleccionar
    if (esInit && savedClasif) sel.value = savedClasif;
  } else {
    // Ocultar selector, mostrar badge estático con el ganador
    wrap.style.display = 'none';
    if (ambosRellenos) {
      const ganadorId  = parseInt(gl) > parseInt(gv) ? localId  : visitId;
      const ganadorNom = parseInt(gl) > parseInt(gv) ? localNom : visitNom;
      const ganadorBan = parseInt(gl) > parseInt(gv) ? localBan : visitBan;
      sel.value = ganadorId;
      if (staticDiv) {
        staticDiv.style.display = '';
        staticNombre.textContent = `${ganadorBan} ${ganadorNom}`;
      }
    } else {
      if (staticDiv) staticDiv.style.display = 'none';
    }
  }
}

document.querySelectorAll('.input-pron').forEach(row => {
  actualizarClasif(row, true); // init con pre-selección
  row.querySelector('.pron-local')?.addEventListener('input',  () => actualizarClasif(row, false));
  row.querySelector('.pron-visit')?.addEventListener('input',  () => actualizarClasif(row, false));
});

document.querySelectorAll('.btn-guardar').forEach(btn => {
  btn.addEventListener('click', async function() {
    const row = this.closest('.partido-card');
    const inputPron = row.querySelector('.input-pron');
    const id = this.dataset.id;
    const gl = row.querySelector('.pron-local').value;
    const gv = row.querySelector('.pron-visit').value;
    const msg = row.querySelector('.msg-pron');

    if (gl===''||gv==='') { msg.textContent='Ingresá ambos goles'; msg.className='msg-pron small text-danger'; return; }

    // Determinar clasificado
    const esEmpate = parseInt(gl) === parseInt(gv);
    let clasificado_id = null;
    if (esEmpate) {
      clasificado_id = row.querySelector('.sel-clasif')?.value;
      if (!clasificado_id) { msg.textContent='Elegí quién clasifica'; msg.className='msg-pron small text-danger'; return; }
    } else {
      clasificado_id = parseInt(gl) > parseInt(gv) ? this.dataset.localId : this.dataset.visitId;
    }

    this.disabled = true;
    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    try {
      const res = await fetch('/pronosticos/guardar', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ partido_id: id, goles_local: gl, goles_visitante: gv, clasificado_id })
      });
      const data = await res.json();
      if (data.ok) {
        if (!inputPron.querySelector('.badge-cargado')) {
          const b = document.createElement('span');
          b.className = 'badge bg-success-subtle text-success border border-success-subtle small px-2 badge-cargado';
          b.innerHTML = '<i class="bi bi-check2 me-1"></i>Cargado';
          inputPron.prepend(b);
        }
        msg.textContent='✓ Guardado'; msg.className='msg-pron small text-success';
        setTimeout(()=>{msg.textContent=''},2500);
        this.disabled=false; this.innerHTML='<i class="bi bi-save me-1"></i>Actualizar';
        this.className='btn btn-sm btn-guardar btn-outline-primary';
      } else {
        msg.textContent=data.msg; msg.className='msg-pron small text-danger';
        this.disabled=false; this.innerHTML='<i class="bi bi-save me-1"></i>Guardar';
      }
    } catch(e) {
      msg.textContent='Error de red'; msg.className='msg-pron small text-danger';
      this.disabled=false; this.innerHTML='<i class="bi bi-save me-1"></i>Guardar';
    }
  });
});
</script>

<% } %>

<%- include('partials/footer') %>
