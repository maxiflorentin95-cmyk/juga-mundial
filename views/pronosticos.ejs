<%- include('partials/header') %>

<div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
  <a href="/dashboard" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i> Volver
  </a>
  <div>
    <h2 class="fw-bold mb-0">Mis Pronósticos</h2>
    <div class="text-muted small"><%= pronosticados %> / <%= totalPartidos %> cargados</div>
  </div>
</div>

<!-- Estadísticas -->
<% if (stats && stats.total > 0) { %>
<div class="row g-2 mb-3">
  <div class="col-6 col-md-3">
    <div class="card border-0 bg-primary bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-primary"><%= stats.puntos || 0 %></div>
      <div class="small text-muted">Puntos</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 bg-warning bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-warning"><%= stats.exactos || 0 %></div>
      <div class="small text-muted">Exactos 🎯</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 bg-success bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4 text-success"><%= stats.resultado || 0 %></div>
      <div class="small text-muted">Con resultado ✓</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card border-0 bg-secondary bg-opacity-10 text-center py-2">
      <div class="fw-bold fs-4"><%= stats.total %></div>
      <div class="small text-muted">Cargados</div>
    </div>
  </div>
</div>
<% } %>

<!-- Sistema de puntos -->
<div class="alert alert-info py-2 small mb-3 d-flex align-items-center flex-wrap gap-2">
  <i class="bi bi-info-circle-fill me-1"></i>
  <strong>Puntaje:</strong>
  <span class="badge bg-warning text-dark">🎯 Exacto = 5 pts</span>
  <span class="badge bg-success">≈ Diferencia = 3 pts</span>
  <span class="badge bg-primary">✓ Ganador = 2 pts</span>
  <span class="badge bg-secondary">✗ Fallado = 0 pts</span>
  <span class="text-muted ms-1">· Cierre al inicio del partido. Podés modificar hasta ese momento.</span>
</div>

<!-- Lista cronológica por fecha -->
<% fechas.forEach(fecha => { %>
<%
  const dateObj = new Date(fecha + 'T12:00:00Z');
  const labelFecha = dateObj.toLocaleDateString('es-AR', { weekday:'long', day:'numeric', month:'long' });
  const partidos = porFecha[fecha];
  const hayAbiertos = partidos.some(p => !p.cerrado);
%>

<div class="mb-4">
  <!-- Header de fecha -->
  <div class="d-flex align-items-center gap-2 mb-2">
    <span class="badge bg-dark px-3 py-2 fs-6 text-capitalize"><%= labelFecha %></span>
    <% if (hayAbiertos) { %>
    <span class="badge bg-success">Abiertos</span>
    <% } %>
    <hr class="flex-grow-1 my-0 border-secondary opacity-25">
  </div>

  <!-- Partidos del día -->
  <div class="card border-0 shadow-sm overflow-hidden">
    <% partidos.forEach((p, idx) => { %>
    <div class="partido-row partido-card p-3 <%= idx > 0 ? 'border-top' : '' %>" data-id="<%= p.id %>"
         style="<%= p.estado==='finalizado' ? 'background:var(--bs-success-bg-subtle,#d1e7dd)10' : '' %>">

      <!-- Fila principal: hora · equipos · estado -->
      <div class="d-flex align-items-center gap-2 gap-md-3 flex-wrap">

        <!-- Hora + grupo -->
        <div class="text-center" style="min-width:52px">
          <div class="fw-bold small lh-1"><%= p.hora %></div>
          <div class="text-muted" style="font-size:.65rem"><%= p.grupo ? 'Gr. ' + p.grupo : p.fase ? p.fase.replace('dieciseisavos','16vos').replace('octavos','8vos').replace('cuartos','Cuartos').replace('semifinal','Semi').replace('tercer_puesto','3er P.').replace('final','Final') : '' %></div>
        </div>

        <!-- Equipos y marcador/VS -->
        <div class="d-flex align-items-center flex-grow-1 gap-1 gap-md-2">
          <!-- Local -->
          <div class="d-flex align-items-center gap-1 flex-grow-1 justify-content-end">
            <span class="fw-semibold small text-end" style="max-width:90px;line-height:1.2"><%= p.local_corto %></span>
            <span class="fs-4 lh-1"><%= p.local_bandera %></span>
          </div>

          <!-- Resultado o VS -->
          <div class="text-center px-1" style="min-width:56px">
            <% if (p.estado === 'finalizado') { %>
              <span class="badge bg-dark px-2 py-1 fw-bold"><%= p.goles_local %>–<%= p.goles_visitante %></span>
            <% } else { %>
              <span class="text-muted fw-bold small">vs</span>
            <% } %>
          </div>

          <!-- Visitante -->
          <div class="d-flex align-items-center gap-1 flex-grow-1">
            <span class="fs-4 lh-1"><%= p.visit_bandera %></span>
            <span class="fw-semibold small" style="max-width:90px;line-height:1.2"><%= p.visit_corto %></span>
          </div>
        </div>

        <!-- Estado badge -->
        <div class="ms-auto">
          <span class="badge <%= p.estado==='finalizado' ? 'bg-success' : p.cerrado ? 'bg-secondary' : 'bg-primary' %> text-nowrap">
            <%= p.estado==='finalizado' ? 'Final' : p.cerrado ? 'Cerrado' : 'Abierto' %>
          </span>
        </div>
      </div>

      <!-- Fila de pronóstico -->
      <div class="mt-2 ms-0 ms-md-5 ps-md-3">
        <% if (p.estado === 'finalizado') { %>
          <!-- Finalizado: mostrar pronóstico y puntos -->
          <% if (p.pronostico) { %>
          <%
            const esElim = p.fase && p.fase !== 'grupos';
            const bonus  = esElim && p.clasificado_id && p.pronostico.clasificado_id &&
                           parseInt(p.pronostico.clasificado_id) === parseInt(p.clasificado_id) ? 2 : 0;
            const base   = p.pronostico.puntos_obtenidos - bonus;
          %>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small">Tu pronóstico:</span>
            <span class="badge bg-dark px-2 py-1"><%= p.pronostico.goles_local %>–<%= p.pronostico.goles_visitante %></span>
            <span class="badge px-2 py-1
              <%= base===5 ? 'bg-warning text-dark' : base===3 ? 'bg-success' : base===2 ? 'bg-primary' : 'bg-secondary' %>">
              <%= base===5 ? '🎯' : base===3 ? '≈' : base===2 ? '✓' : '✗' %>
              +<%= base %> pts
            </span>
            <% if (bonus > 0) { %>
              <span class="badge bg-info text-dark px-2 py-1">🏅 +<%= bonus %> pts</span>
            <% } %>
            <% if (esElim && p.pronostico.clasificado_id) { %>
              <span class="text-muted small">
                · Clasif: <%= parseInt(p.pronostico.clasificado_id) === parseInt(p.equipo_local_id) ? p.local_bandera + ' ' + p.local_corto : p.visit_bandera + ' ' + p.visit_corto %>
                <% if (p.clasificado_id) { %><%= parseInt(p.pronostico.clasificado_id) === parseInt(p.clasificado_id) ? '✅' : '❌' %><% } %>
              </span>
            <% } %>
          </div>
          <% } else { %>
          <span class="text-muted small fst-italic">No pronosticaste este partido</span>
          <% } %>

        <% } else if (p.cerrado) { %>
          <!-- Cerrado, en juego -->
          <% if (p.pronostico) { %>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small">Tu pronóstico:</span>
            <span class="badge bg-dark px-2 py-1"><%= p.pronostico.goles_local %>–<%= p.pronostico.goles_visitante %></span>
            <% if (p.fase && p.fase !== 'grupos' && p.pronostico.clasificado_id) { %>
              <span class="badge bg-info text-dark px-2 py-1">
                🏅 <%= parseInt(p.pronostico.clasificado_id) === parseInt(p.equipo_local_id) ? p.local_bandera + ' ' + p.local_corto : p.visit_bandera + ' ' + p.visit_corto %>
              </span>
            <% } %>
            <span class="text-muted small"><i class="bi bi-lock-fill"></i> cerrado</span>
          </div>
          <% } else { %>
          <span class="text-muted small fst-italic"><i class="bi bi-lock-fill"></i> No pronosticaste este partido</span>
          <% } %>

        <% } else { %>
          <!-- Abierto: formulario editable -->
          <div class="d-flex align-items-center gap-2 flex-wrap input-pron"
               data-local-id="<%= p.equipo_local_id %>"
               data-visit-id="<%= p.equipo_visitante_id %>"
               data-local-nombre="<%= p.local_corto %>"
               data-visit-nombre="<%= p.visit_corto %>"
               data-local-bandera="<%= p.local_bandera %>"
               data-visit-bandera="<%= p.visit_bandera %>"
               data-clasif-id="<%= p.pronostico && p.pronostico.clasificado_id ? p.pronostico.clasificado_id : '' %>">
            <% if (p.pronostico) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle small px-2 badge-cargado">
              <i class="bi bi-check2 me-1"></i>Cargado
            </span>
            <% } %>
            <div class="d-flex align-items-center gap-1">
              <span class="text-muted small text-nowrap"><%= p.local_corto %>:</span>
              <input type="number" class="form-control form-control-sm text-center fw-bold pron-local"
                min="0" max="20" style="width:52px"
                value="<%= p.pronostico ? p.pronostico.goles_local : '' %>"
                placeholder="0">
              <span class="fw-bold text-muted">–</span>
              <input type="number" class="form-control form-control-sm text-center fw-bold pron-visit"
                min="0" max="20" style="width:52px"
                value="<%= p.pronostico ? p.pronostico.goles_visitante : '' %>"
                placeholder="0">
              <span class="text-muted small text-nowrap">:<%= p.visit_corto %></span>
            </div>
            <% if (p.fase && p.fase !== 'grupos') { %>
            <!-- Selector (solo si empate) -->
            <div class="clasif-wrap" style="display:none">
              <select class="form-select form-select-sm sel-clasif" style="min-width:130px">
                <option value="">¿Quién clasifica?</option>
                <option value="<%= p.equipo_local_id %>"><%= p.local_bandera %> <%= p.local_corto %></option>
                <option value="<%= p.equipo_visitante_id %>"><%= p.visit_bandera %> <%= p.visit_corto %></option>
              </select>
            </div>
            <!-- Badge auto (si hay ganador claro) -->
            <div class="clasif-static badge bg-info text-dark" style="display:none">
              🏅 Clasifica: <span class="clasif-static-nombre"></span>
            </div>
            <% } %>
            <button class="btn btn-sm btn-guardar <%= p.pronostico ? 'btn-outline-primary' : 'btn-primary' %>"
              data-id="<%= p.id %>"
              data-fase="<%= p.fase %>"
              data-local-id="<%= p.equipo_local_id %>"
              data-visit-id="<%= p.equipo_visitante_id %>">
              <i class="bi bi-save me-1"></i><%= p.pronostico ? 'Actualizar' : 'Guardar' %>
            </button>
            <span class="msg-pron small"></span>
          </div>
        <% } %>
      </div>

    </div>
    <% }) %>
  </div>
</div>
<% }) %>

<script>
function actualizarClasif(row, esInit) {
  const inputPron = row.querySelector('.input-pron');
  const wrap      = inputPron?.querySelector('.clasif-wrap');
  if (!wrap) return;

  const gl = row.querySelector('.pron-local').value;
  const gv = row.querySelector('.pron-visit').value;
  const sel         = wrap.querySelector('.sel-clasif');
  const staticDiv   = inputPron.querySelector('.clasif-static');
  const staticNom   = inputPron.querySelector('.clasif-static-nombre');

  const localId   = inputPron.dataset.localId;
  const visitId   = inputPron.dataset.visitId;
  const localNom  = inputPron.dataset.localNombre;
  const visitNom  = inputPron.dataset.visitNombre;
  const localBan  = inputPron.dataset.localBandera;
  const visitBan  = inputPron.dataset.visitBandera;
  const savedClasif = inputPron.dataset.clasifId;

  const ambos   = gl !== '' && gv !== '';
  const esEmpate = ambos && parseInt(gl) === parseInt(gv);

  if (esEmpate) {
    wrap.style.display = '';
    if (staticDiv) staticDiv.style.display = 'none';
    if (esInit && savedClasif) sel.value = savedClasif;
  } else {
    wrap.style.display = 'none';
    if (ambos) {
      const esLocal = parseInt(gl) > parseInt(gv);
      sel.value = esLocal ? localId : visitId;
      if (staticDiv) {
        staticDiv.style.display = '';
        staticNom.textContent = `${esLocal ? localBan : visitBan} ${esLocal ? localNom : visitNom}`;
      }
    } else {
      if (staticDiv) staticDiv.style.display = 'none';
    }
  }
}

document.querySelectorAll('.partido-card').forEach(row => {
  actualizarClasif(row, true);
  row.querySelector('.pron-local')?.addEventListener('input', () => actualizarClasif(row, false));
  row.querySelector('.pron-visit')?.addEventListener('input', () => actualizarClasif(row, false));
});

document.querySelectorAll('.btn-guardar').forEach(btn => {
  btn.addEventListener('click', async function () {
    const row = this.closest('.partido-card');
    const id = this.dataset.id;
    const fase = this.dataset.fase;
    const gl = row.querySelector('.pron-local').value;
    const gv = row.querySelector('.pron-visit').value;
    const msg = row.querySelector('.msg-pron');

    if (gl === '' || gv === '') {
      msg.textContent = 'Ingresá ambos goles';
      msg.className = 'msg-pron small text-danger';
      return;
    }

    // Para eliminatoria: determinar clasificado
    let clasificado_id = null;
    if (fase && fase !== 'grupos') {
      const esEmpate = parseInt(gl) === parseInt(gv);
      if (esEmpate) {
        clasificado_id = row.querySelector('.sel-clasif')?.value;
        if (!clasificado_id) {
          msg.textContent = 'Elegí quién clasifica';
          msg.className = 'msg-pron small text-danger';
          return;
        }
      } else {
        clasificado_id = parseInt(gl) > parseInt(gv) ? this.dataset.localId : this.dataset.visitId;
      }
    }

    this.disabled = true;
    this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

    try {
      const res = await fetch('/pronosticos/guardar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ partido_id: id, goles_local: gl, goles_visitante: gv, clasificado_id })
      });
      const data = await res.json();

      if (data.ok) {
        // Mostrar badge "Cargado" si no existe
        const inputPron = row.querySelector('.input-pron');
        let badge = inputPron.querySelector('.badge-cargado');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'badge bg-success-subtle text-success border border-success-subtle small px-2 badge-cargado';
          badge.innerHTML = '<i class="bi bi-check2 me-1"></i>Cargado';
          inputPron.prepend(badge);
        }
        // Actualizar valores del input con lo que se guardó
        row.querySelector('.pron-local').value = data.gl;
        row.querySelector('.pron-visit').value = data.gv;
        // Mensaje breve que desaparece
        msg.textContent = '✓ Guardado';
        msg.className = 'msg-pron small text-success';
        setTimeout(() => { msg.textContent = ''; }, 2500);
        // Botón vuelve a ser editable
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-save me-1"></i>Actualizar';
        this.className = 'btn btn-sm btn-guardar btn-outline-primary';
      } else {
        msg.textContent = data.msg;
        msg.className = 'msg-pron small text-danger';
        this.disabled = false;
        this.innerHTML = '<i class="bi bi-save me-1"></i>Guardar';
      }
    } catch (e) {
      msg.textContent = 'Error de red';
      msg.className = 'msg-pron small text-danger';
      this.disabled = false;
      this.innerHTML = '<i class="bi bi-save me-1"></i>Guardar';
    }
  });
});

// Enter en inputs para guardar rápido
document.querySelectorAll('.pron-local, .pron-visit').forEach(input => {
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      const card = this.closest('.partido-card');
      card.querySelector('.btn-guardar')?.click();
    }
  });
});
</script>

<%- include('partials/footer') %>
